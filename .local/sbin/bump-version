#!/usr/bin/env bash
set -euo pipefail

package="${1:?package is required}"
mode="${2:?release level is required}"

case "$mode" in
  major|minor|patch) ;;
  *) echo "unsupported release level: $mode" >&2; exit 1 ;;
esac

current_version="$(cargo metadata --no-deps --format-version=1 | jq -er --arg package "$package" '
  .packages[] | select(.name == $package) | .version
')"
if ! [[ "$current_version" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
  echo "a stable SemVer version is required for $package: $current_version" >&2
  exit 1
fi

major="$((10#${BASH_REMATCH[1]}))"
minor="$((10#${BASH_REMATCH[2]}))"
patch="$((10#${BASH_REMATCH[3]}))"

# Cargo's conventional pre-1.0 compatibility rule treats a `minor` bump as a
# breaking change and a `patch` bump as compatible. Compatible release levels
# therefore map to a patch increment.
if (( major == 0 )); then
  case "$mode" in
    major) printf '0.%d.0\n' "$((minor + 1))" ;;
    minor|patch) printf '0.%d.%d\n' "$minor" "$((patch + 1))" ;;
  esac
else
  case "$mode" in
    major) printf '%d.0.0\n' "$((major + 1))" ;;
    minor) printf '%d.%d.0\n' "$major" "$((minor + 1))" ;;
    patch) printf '%d.%d.%d\n' "$major" "$minor" "$((patch + 1))" ;;
  esac
fi
