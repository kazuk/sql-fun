#!/usr/bin/env python3
"""Copy a trusted normal-CI candidate into the stable release back-commit tree."""
import argparse
from pathlib import Path
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
from semver_intent import commands, storage
from semver_intent.model import CheckError


def is_snapshot_release(tag):
    parser = Path(__file__).with_name("parse-release-version")
    identity = commands.run([str(parser), tag], capture=True).strip().split("\t")
    return identity[-1] == "snapshot"


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--candidate", type=Path, required=True)
    parser.add_argument("--release-tag", required=True)
    parser.add_argument("--destination", type=Path, required=True,
                        help="back-commit checkout's .local/semver_baseline.tar.gz")
    args = parser.parse_args()
    if is_snapshot_release(args.release_tag):
        print("snapshot: active baseline unchanged")
        return
    # The caller selects a successful CI run for the exact release source.
    # GitHub Actions metadata is the provenance boundary.
    storage.adopt_candidate(args.candidate, args.destination)


if __name__ == "__main__":
    try:
        main()
    except (CheckError, OSError) as error:
        print(f"adopt-semver-baseline: {error}", file=sys.stderr)
        sys.exit(2)
