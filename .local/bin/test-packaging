#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

metadata="$(cargo metadata --no-deps --format-version=1)"
baseline_revision="$(taplo get --file-path Cargo.toml 'workspace.metadata.baseline')"

while IFS= read -r package; do
  release_level="$(taplo get --file-path Cargo.toml "workspace.metadata.next-release.$package")"
  crate_kinds="$(jq -r --arg package "$package" '
    .packages[] | select(.name == $package) | .targets[].kind[]
  ' <<<"$metadata")"
  if grep -Fxq lib <<<"$crate_kinds"; then
    cargo semver-checks --baseline-rev "$baseline_revision" --package "$package" --release-type "$release_level"
  fi
done < <(jq -r '.packages[] | select(.source == null and .publish != []) | .name' <<<"$metadata")

# This exploratory helper remains until #259 adopts the canonical release
# workflow. Version mutation is delegated to the reusable implementation.
"$repo_root/.local/bin/materialize-release-versions" --release
