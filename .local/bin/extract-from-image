#!/bin/bash

set -euo pipefail

PGVER="${1:-"17"}"

TAG="postgres:${PGVER}"
NAME="pg_builtin_${PGVER}"
PSQL="docker exec -i ${NAME} psql -X -qAt -U postgres -d postgres -v ON_ERROR_STOP=1"

BUILTIN_BASE_PATH="${SQL_FUN_HOME}/postgres/${PGVER}"
BUILTIN_TYPE_PATH="${BUILTIN_BASE_PATH}/pg_type.json"
BUILTIN_FUNC_PATH="${BUILTIN_BASE_PATH}/functions.json"
BUILTIN_FUNC_DETAIL_PATH="${BUILTIN_BASE_PATH}/func_detail.json"
BUILTIN_BINARY="${BUILTIN_BASE_PATH}/binary_op.json"
BUITIN_LEFT_UNARY="${BUILTIN_BASE_PATH}/left_unary_op.json"
BUITIN_RIGHT_UNARY="${BUILTIN_BASE_PATH}/right_unary_op.json"
BUITIN_CASTS="${BUILTIN_BASE_PATH}/casts.json"

if ! command -v docker >/dev/null 2>&1; then
  echo "docker is required" >&2
  exit 1
fi

if ! command -v jq >/dev/null 2>&1; then
  echo "jq is required" >&2
  exit 1
fi

mkdir -p "${BUILTIN_BASE_PATH}"

echo "start postgres container ${TAG}"

docker rm -f "$NAME" >/dev/null 2>&1 || true
docker run \
  -d \
  --name "${NAME}" \
  -e POSTGRES_HOST_AUTH_METHOD=trust \
  "${TAG}"

until docker exec "${NAME}" pg_isready -U postgres >/dev/null 2>&1; do
  sleep 0.5
done
echo "postgres is ready"

echo "extract pg_type"
BUILTIN_TYPES=$(
  ${PSQL} << 'SQL'
select coalesce(
  json_agg(
    json_build_object('name', t.typname)
    order by t.oid
  ),
  '[]'::json
)
from pg_catalog.pg_type t
where t.typnamespace = 'pg_catalog'::regnamespace
  and t.typtype <> 'c'
  and t.typname !~ '^__'
  and t.typname !~ '^pg_toast_'
  and t.typname !~ '^pg_temp_'
  and t.typname !~ '^pg_toast_temp_'
  and (t.typname !~ '^_' or t.typname = '_record');
SQL
)

echo "${BUILTIN_TYPES}" | jq '.' > "${BUILTIN_TYPE_PATH}"

echo "extract functions"
BUILTIN_FUNCS=$(
  ${PSQL} << 'SQL'
with base as (
  select
    p.oid,
    p.proname,
    rt.typname as retname,
    p.proisstrict,
    p.proargtypes,
    p.proargtypes::text as argtypes_text
  from pg_catalog.pg_proc p
  join pg_catalog.pg_namespace n on n.oid = p.pronamespace
  join pg_catalog.pg_type rt on rt.oid = p.prorettype
  left join pg_catalog.pg_description d
    on d.objoid = p.oid and d.classoid = 'pg_proc'::regclass
  where n.nspname = 'pg_catalog'
    and coalesce(d.description, '') !~ 'I/O|support'
    and rt.typname not in ('trigger', 'internal')
    and not exists (
      select 1
      from unnest(p.proargtypes::oid[]) as t(oid)
      join pg_catalog.pg_type at on at.oid = t.oid
      where at.typname = 'internal'
    )
    and p.proname ~ '^[a-z]'
    and p.proname <> rt.typname
),
args as (
  select
    b.oid,
    array_agg(at.typname order by u.ord) as args
  from base b
  left join lateral unnest(b.proargtypes::oid[]) with ordinality as u(oid, ord)
    on true
  left join pg_catalog.pg_type at on at.oid = u.oid
  group by b.oid
),
funcs as (
  select
    b.proname,
    b.argtypes_text,
    json_build_object(
      'name', b.proname,
      'args', coalesce(a.args, array[]::text[]),
      'ret', b.retname,
      'is_strict', b.proisstrict
    ) as obj
  from base b
  left join args a on a.oid = b.oid
),
grouped as (
  select
    proname,
    json_agg(obj order by argtypes_text) as overloads
  from funcs
  group by proname
)
select coalesce(
  json_agg(
    json_build_object('name', proname, 'overloads', overloads)
    order by proname
  ),
  '[]'::json
)
from grouped;
SQL
)

echo "${BUILTIN_FUNCS}" | jq '.' > "${BUILTIN_FUNC_PATH}"

echo "extract function details"
BUILTIN_FUNC_DETAIL=$(
  ${PSQL} << 'SQL'
with detail as (
  select
    p.oid,
    p.proname,
    p.proallargtypes,
    p.proargmodes,
    p.proargnames
  from pg_catalog.pg_proc p
  join pg_catalog.pg_namespace n on n.oid = p.pronamespace
  where n.nspname = 'pg_catalog'
    and p.proallargtypes is not null
),
allargs as (
  select
    d.oid,
    array_agg(t.typname order by u.ord)::text as allargtypes
  from detail d
  join lateral unnest(d.proallargtypes) with ordinality as u(oid, ord) on true
  join pg_catalog.pg_type t on t.oid = u.oid
  group by d.oid
)
select coalesce(
  json_agg(
    json_build_object(
      'name', d.proname,
      'allargtypes', a.allargtypes,
      'argmodes', d.proargmodes::text,
      'argnames', d.proargnames::text
    )
    order by d.proname
  ),
  '[]'::json
)
from detail d
join allargs a on a.oid = d.oid;
SQL
)

echo "${BUILTIN_FUNC_DETAIL}" | jq '.' > "${BUILTIN_FUNC_DETAIL_PATH}"

echo "extract binary operators"
BUILTIN_BINARY_OPS=$(
  ${PSQL} << 'SQL'
with ops as (
  select
    o.oprname,
    l.typname as left_type,
    r.typname as right_type,
    res.typname as result,
    coalesce(p.proisstrict, false) as strict
  from pg_catalog.pg_operator o
  join pg_catalog.pg_type l on l.oid = o.oprleft
  join pg_catalog.pg_type r on r.oid = o.oprright
  join pg_catalog.pg_type res on res.oid = o.oprresult
  left join pg_catalog.pg_proc p on p.oid = o.oprcode
  where o.oprleft <> 0 and o.oprright <> 0
),
grouped as (
  select
    oprname,
    json_agg(
      json_build_object(
        'left', left_type,
        'right', right_type,
        'result', result,
        'strict', strict
      )
      order by left_type, right_type
    ) as entries
  from ops
  group by oprname
)
select coalesce(json_object_agg(oprname, entries), '{}'::json)
from grouped;
SQL
)

echo "${BUILTIN_BINARY_OPS}" | jq '.' > "${BUILTIN_BINARY}"

echo "extract left unary operators"
BUILTIN_LEFT_UNARY_OPS=$(
  ${PSQL} << 'SQL'
with ops as (
  select
    o.oprname,
    l.typname as input_type,
    res.typname as result,
    coalesce(p.proisstrict, false) as strict
  from pg_catalog.pg_operator o
  join pg_catalog.pg_type l on l.oid = o.oprleft
  join pg_catalog.pg_type res on res.oid = o.oprresult
  left join pg_catalog.pg_proc p on p.oid = o.oprcode
  where o.oprleft <> 0 and o.oprright = 0
),
grouped as (
  select
    oprname,
    json_agg(
      json_build_object(
        'input', input_type,
        'result', result,
        'strict', strict
      )
      order by input_type
    ) as entries
  from ops
  group by oprname
)
select coalesce(json_object_agg(oprname, entries), '{}'::json)
from grouped;
SQL
)

echo "${BUILTIN_LEFT_UNARY_OPS}" | jq '.' > "${BUITIN_LEFT_UNARY}"

echo "extract right unary operators"
BUILTIN_RIGHT_UNARY_OPS=$(
  ${PSQL} << 'SQL'
with ops as (
  select
    o.oprname,
    r.typname as input_type,
    res.typname as result,
    coalesce(p.proisstrict, false) as strict
  from pg_catalog.pg_operator o
  join pg_catalog.pg_type r on r.oid = o.oprright
  join pg_catalog.pg_type res on res.oid = o.oprresult
  left join pg_catalog.pg_proc p on p.oid = o.oprcode
  where o.oprleft = 0 and o.oprright <> 0
),
grouped as (
  select
    oprname,
    json_agg(
      json_build_object(
        'input', input_type,
        'result', result,
        'strict', strict
      )
      order by input_type
    ) as entries
  from ops
  group by oprname
)
select coalesce(json_object_agg(oprname, entries), '{}'::json)
from grouped;
SQL
)

echo "${BUILTIN_RIGHT_UNARY_OPS}" | jq '.' > "${BUITIN_RIGHT_UNARY}"

echo "extract casts"
BUILTIN_CASTS=$(
  ${PSQL} << 'SQL'
with preferred as (
  select array_agg(t.typname) as names
  from pg_catalog.pg_type t
  where t.typispreferred
),
casts as (
  select
    src.typname as source,
    tgt.typname as target,
    case
      when c.castfunc = 0 then '0'
      else (
        select p.proname || '(' || coalesce(array_to_string(a.args, ','), '') || ')'
        from pg_catalog.pg_proc p
        left join lateral (
          select array_agg(t.typname order by u.ord) as args
          from unnest(p.proargtypes::oid[]) with ordinality as u(oid, ord)
          join pg_catalog.pg_type t on t.oid = u.oid
        ) a on true
        where p.oid = c.castfunc
      )
    end as func,
    c.castmethod::text as method,
    c.castcontext::text as context,
    coalesce(tgt.typname = any(preferred.names), false) as is_prefferd
  from pg_catalog.pg_cast c
  join pg_catalog.pg_type src on src.oid = c.castsource
  join pg_catalog.pg_type tgt on tgt.oid = c.casttarget
  cross join preferred
),
grouped as (
  select
    source,
    json_object_agg(
      target,
      json_build_object(
        'func', func,
        'method', method,
        'context', context,
        'is_prefferd', is_prefferd
      )
    ) as targets
  from casts
  group by source
)
select coalesce(json_object_agg(source, targets), '{}'::json)
from grouped;
SQL
)

echo "${BUILTIN_CASTS}" | jq '.' > "${BUITIN_CASTS}"

echo "stop and remove container"
docker rm -f "$NAME" >/dev/null 2>&1 || true
