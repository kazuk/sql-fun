#!/bin/bash
set -euo pipefail

CLEAN_TARGET=0
REBUILD=0
BUILD_ONLY=0

for a in "$@"; do
    case "$a" in
      --clean) CLEAN_TARGET=1 ;;
      --rebuild) REBUILD=1 ;;
      --build-only) BUILD_ONLY=1 ;;
    esac
done

if (( BUILD_ONLY == 0 )); then
    if ! docker compose version >/dev/null 2>&1; then
        echo "Install the host Docker Compose plugin to launch the builder; see ci/github-actions/README.md." >&2
        exit 1
    fi
    compose_help=$(docker compose up --help)
    if [[ "$compose_help" != *--wait-timeout* ]]; then
        echo "Upgrade the host Docker Compose plugin: up --wait and --wait-timeout are required." >&2
        exit 1
    fi
fi

if (( REBUILD ==1 )); then
    REBUILD_ARGS=(--pull --no-cache)
else
    REBUILD_ARGS=()
fi

for tool in CARGO_BINSTALL TYPOS; do
  case "$tool" in
    CARGO_BINSTALL) repository=cargo-bins/cargo-binstall ;;
    TYPOS) repository=crate-ci/typos ;;
  esac
  release=$(curl --fail --silent --show-error --location \
    "https://api.github.com/repos/${repository}/releases/latest")
  tag=$(jq -er '
    select(.draft == false and .prerelease == false)
    | .tag_name | select(test("^v[0-9]+\\.[0-9]+\\.[0-9]+$"))
  ' <<<"$release") || { echo "Invalid release tag or asset digest for $repository" >&2; exit 1; }
  case "$tool" in
    CARGO_BINSTALL) asset=cargo-binstall-x86_64-unknown-linux-musl.tgz ;;
    TYPOS) asset="typos-${tag}-x86_64-unknown-linux-musl.tar.gz" ;;
  esac
  checksum=$(jq -er --arg asset "$asset" '
    [.assets[] | select(.name == $asset)]
    | select(length == 1) | .[0].digest
    | select(type == "string" and test("^sha256:[0-9a-f]{64}$"))
    | ltrimstr("sha256:")
  ' <<<"$release") || { echo "Invalid release tag or asset digest for $repository" >&2; exit 1; }
  printf -v "${tool}_TAG" '%s' "$tag"
  printf -v "${tool}_SHA256" '%s' "$checksum"
  printf '%s release: %s\n' "$repository" "$tag"
done

IMAGE=ci-builder:local
previous_size=$(docker image inspect --format '{{.Size}}' "$IMAGE" 2>/dev/null || true)

# GIT_ROOT setup in our repostitory .envrc
docker build \
  "${REBUILD_ARGS[@]}" \
  "${GIT_ROOT}/ci/github-actions/." \
  -t "$IMAGE" \
  --build-arg "SERENA_TAG=v0.1.4" \
  --build-arg "CARGO_BINSTALL_TAG=$CARGO_BINSTALL_TAG" \
  --build-arg "CARGO_BINSTALL_SHA256=$CARGO_BINSTALL_SHA256" \
  --build-arg "TYPOS_TAG=$TYPOS_TAG" \
  --build-arg "TYPOS_SHA256=$TYPOS_SHA256"

test "$(docker run --rm "$IMAGE" cargo binstall -V)" = "${CARGO_BINSTALL_TAG#v}"
test "$(docker run --rm "$IMAGE" typos --version)" = "typos-cli ${TYPOS_TAG#v}"

test "$(docker run --rm "$IMAGE" scrut --version)" = "scrut 0.4.3"

image_size=$(docker image inspect --format '{{.Size}}' "$IMAGE")
awk -v image="$IMAGE" -v size="$image_size" -v previous="$previous_size" 'BEGIN {
    printf "Image %s: %.1f MiB (%s bytes, uncompressed)\n", image, size / 1048576, size
    if (previous != "") {
        printf "Change from previous local image: %+.1f MiB\n", (size - previous) / 1048576
    }
}'

if (( BUILD_ONLY == 1 )); then
    exit 0
fi

if (( CLEAN_TARGET == 1 )); then
    docker volume rm -f ci_target 2>/dev/null || true
fi

if docker volume inspect "user_home" >/dev/null 2>&1; then
  echo "exists"
else
  docker volume create user_home
fi

docker run --rm -t \
  --user root \
  -e HOST_UID="$(id -u)" \
  -e HOST_GID="$(id -g)" \
  --volume "user_home:/home:rw" \
  ci-builder:local \
  bash -lc '
    uid="$HOST_UID"
    gid="$HOST_GID"
    mkdir -p /home/builder/.codex
    chown -R $uid:$gid /home/builder
    install -m 0644 -o "$uid" -g "$gid" \
      /usr/local/config-template/codex-config.toml \
      /home/builder/.codex/config.toml
    if [[ ! -f /home/builder/.bashrc ]]; then
      install -m 0644 -o "$uid" -g "$gid" /dev/stdin /home/builder/.bashrc <<'"'"'EOF'"'"'
# minimal bashrc (container)
# direnv hook
if command -v direnv >/dev/null 2>&1; then
  eval "$(direnv hook bash)"
fi
EOF
    fi
  '

if docker volume inspect "ci_target" >/dev/null 2>&1; then
  echo "exists"
else
  docker volume create ci_target
  docker run --rm -t \
    --user root \
    --volume "ci_target:/home/builder/workspace/target:rw" \
    ci-builder:local \
    bash -lc "chown -R $(id -u):$(id -g) /home/builder/workspace/target"
fi

compose_project="sql-fun-oracle-$(id -u)-$(date +%s)-$$-$RANDOM"
compose=(docker compose --env-file /dev/null
    --project-name "$compose_project"
    --file "${GIT_ROOT}/ci/github-actions/compose.yaml")
export BUILDER_UID="$(id -u)" BUILDER_GID="$(id -g)"
GITHUB_TOKEN=$(gh auth token)
export GITHUB_TOKEN
compose_args=(-e GITHUB_TOKEN)
if [[ -n "${OPENAI_API_KEY:-}" ]]; then
    export OPENAI_API_KEY
    compose_args+=(-e OPENAI_API_KEY)
else
    echo "Warning: OPENAI_API_KEY is not set; AI/LLM tasks are disabled."
fi

cleanup() {
    session_status=$?
    trap - EXIT INT TERM
    if ! "${compose[@]}" down --volumes --timeout 10; then
        echo "Compose cleanup failed; remove project $compose_project using the recovery instructions in ci/github-actions/README.md." >&2
        if (( session_status == 0 )); then
            session_status=1
        fi
    fi
    exit "$session_status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
printf 'Oracle Compose project: %s\n' "$compose_project"
"${compose[@]}" up --wait --wait-timeout 120 postgres15 postgres16 postgres17 postgres18
"${compose[@]}" run --rm --no-deps "${compose_args[@]}" builder bash
