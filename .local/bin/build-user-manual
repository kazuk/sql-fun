#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"

mdbook build

# The release workflow publishes the generated user_manual directory unchanged.
# Keep the default highlighter theme downloadable at this stable Pages path.
install -Dm644 \
  sql-fun-home/highlighter/theme/default.toml \
  user_manual/highlighter/default.toml
