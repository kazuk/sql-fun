#!/usr/bin/env python3
"""Offline regression tests for the contributor check-flow command."""

import json
import os
from pathlib import Path
import shutil
import subprocess
import tempfile
import unittest


ROOT = Path(__file__).resolve().parents[2]
DRIVER = r'''#!/usr/bin/env python3
import json
import os
from pathlib import Path
import sys

name = Path(sys.argv[0]).name
args = sys.argv[1:]
with open(os.environ["FLOW_TEST_CALLS"], "a") as calls:
    calls.write(json.dumps([name, *args]) + "\n")
command = " ".join([name, *args])
if name == "cargo" and args[0] == "metadata":
    if os.environ.get("FLOW_TEST_FAIL") == "cargo metadata":
        sys.exit(37)
    print(json.dumps({"packages": [], "target_directory": "target"}))
    sys.exit(0)
print("tool stdout: " + command)
print("tool stderr: " + command, file=sys.stderr)
if os.environ.get("FLOW_TEST_DIAGNOSTICS"):
    print("warning[E0123]: useful warning", file=sys.stderr)
    print("  --> src/lib.rs:2:3", file=sys.stderr)
    print("   |", file=sys.stderr)
    print(" 2 | bad()", file=sys.stderr)
    print("   | ^^^^^", file=sys.stderr)
    print("   = help: use good()", file=sys.stderr)
    print("::warning file=src/lib.rs,line=2::fixture warning", file=sys.stderr)
    print("unmatched output stays in the log", file=sys.stderr)
if os.environ.get("FLOW_TEST_FAIL") == " ".join([name, *args[:1]]):
    for i in range(60):
        print("failure context " + str(i))
    sys.exit(37)
'''


class CheckFlowTests(unittest.TestCase):
    def setUp(self):
        self.temporary = tempfile.TemporaryDirectory(prefix="check-flow-")
        self.addCleanup(self.temporary.cleanup)
        self.root = Path(self.temporary.name) / "repository with spaces"
        self.bin = self.root / "fake-bin"
        self.bin.mkdir(parents=True)
        for directory in (".local/bin", ".local/sbin", ".github/problem-matchers"):
            (self.root / directory).mkdir(parents=True)
        for relative in (
            ".local/bin/check-test-flow",
            ".local/sbin/check-test-flow-diagnostics.py",
            ".github/problem-matchers/rust.json",
        ):
            shutil.copy2(ROOT / relative, self.root / relative)
        for name in (
            "cargo", "cargo-nextest", "taplo", "mdbook", "typos", "graphify",
            "skill-validator", "rumdl", "scrut",
        ):
            path = self.bin / name
            path.write_text(DRIVER)
            path.chmod(0o755)
        for name in (
            "package-linux", "test-materialize-release-versions", "test-release-publication",
            "test-release-preparation", "test-materialize-release-state",
        ):
            path = self.root / ".local/bin" / name
            path.write_text(DRIVER)
            path.chmod(0o755)
        subprocess.run(["git", "init", "-q", str(self.root)], check=True)
        subprocess.run(["git", "-C", str(self.root), "add", "."], check=True)
        subprocess.run([
            "git", "-C", str(self.root), "-c", "user.name=Fixture",
            "-c", "user.email=fixture@example.invalid", "commit", "-qm", "test: fixture",
        ], check=True)
        self.env = os.environ.copy()
        for key in (
            "CI", "GITHUB_ACTIONS", "CODEX_VERSION", "BASH_ENV", "ENV",
            "GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE", "GIT_COMMON_DIR",
            "FLOW_TEST_FAIL", "FLOW_TEST_DIAGNOSTICS",
        ):
            self.env.pop(key, None)
        self.env.update(PATH=f"{self.bin}:{os.environ['PATH']}",
                        FLOW_TEST_CALLS=str(self.root / "calls"))
        self.script = self.root / ".local/bin/check-test-flow"

    def run_flow(self, *args, mode="human", fail=None, diagnostics=False):
        env = self.env.copy()
        if mode == "ci":
            env["CI"] = "true"
        elif mode == "agent":
            env["CODEX_VERSION"] = "fixture"
        if fail:
            env["FLOW_TEST_FAIL"] = fail
        if diagnostics:
            env["FLOW_TEST_DIAGNOSTICS"] = "1"
        return subprocess.run([str(self.script), *args], cwd=self.root, env=env,
                              capture_output=True, text=True)

    def calls(self):
        path = self.root / "calls"
        return [json.loads(line) for line in path.read_text().splitlines()] if path.exists() else []

    def log(self, step):
        return self.root / f".build_logs/check_test_flow_{step}.log"

    def test_success_modes_and_ci_precedence(self):
        for mode in ("human", "agent", "ci"):
            with self.subTest(mode=mode):
                result = self.run_flow("--step=lint", mode=mode, diagnostics=True)
                self.assertEqual(result.returncode, 0, result.stderr)
                if mode == "ci":
                    self.assertIn("tool stdout: cargo clippy", result.stdout)
                    self.assertIn("tool stderr: cargo clippy", result.stderr)
                else:
                    self.assertEqual(result.stdout, "== Running lint\n")
                    raw = self.log("lint").read_text()
                    self.assertIn("tool stdout: cargo clippy", raw)
                    self.assertIn("tool stderr: cargo clippy", raw)
                    self.assertIn("unmatched output", raw)
                    if mode == "agent":
                        self.assertIn("warning[E0123]", result.stderr)
                        self.assertIn("src/lib.rs:2:3", result.stderr)
                        self.assertIn("use good()", result.stderr)
                        self.assertNotIn("tool stderr", result.stderr)
                        self.assertNotIn("unmatched", result.stderr)
                    else:
                        self.assertEqual(result.stderr, "")
        self.env["CODEX_VERSION"] = "fixture"
        for signal in ("CI", "GITHUB_ACTIONS"):
            self.env[signal] = "true"
            self.log("lint").unlink(missing_ok=True)
            result = self.run_flow("--step=lint")
            self.assertEqual(result.returncode, 0)
            self.assertIn("tool stderr", result.stderr)
            self.assertFalse(self.log("lint").exists())
            del self.env[signal]

    def test_fail_fast_and_exact_failure_presentation(self):
        for mode in ("ci", "human", "agent"):
            with self.subTest(mode=mode):
                (self.root / "calls").unlink(missing_ok=True)
                result = self.run_flow("--step=lint", "--step=typos", mode=mode,
                                       fail="cargo clippy")
                self.assertEqual(result.returncode, 37)
                self.assertEqual(self.calls(), [["cargo", "clippy", "--no-deps", "--workspace", "--all-targets"]])
                if mode == "ci":
                    self.assertIn("tool stderr", result.stderr)
                    self.assertNotIn("check-test-flow step", result.stderr)
                    self.assertIn("failure context 0", result.stdout)
                else:
                    self.assertEqual(result.stderr,
                                     f"error: check-test-flow step 'lint' failed; see {self.log('lint')}\n")
                    raw = self.log("lint").read_text()
                    self.assertIn("failure context 0", raw)
                    if mode == "human":
                        self.assertEqual(result.stdout.splitlines()[1:], raw.splitlines()[-50:])
                    else:
                        self.assertEqual(result.stdout, "== Running lint\n")

    def test_first_command_failure_in_other_multicommand_steps(self):
        for step, command in (("workspace", "cargo check"), ("fmt", "cargo fmt"),
                              ("doc", "cargo doc"), ("cli-contract", "cargo build")):
            for mode in ("ci", "human", "agent"):
                with self.subTest(step=step, mode=mode):
                    (self.root / "calls").unlink(missing_ok=True)
                    result = self.run_flow(f"--step={step}", mode=mode, fail=command)
                    self.assertEqual(result.returncode, 37)
                    self.assertEqual(len(self.calls()), 1)

    def test_pipeline_failure(self):
        for mode in ("ci", "human", "agent"):
            result = self.run_flow("--step=cli-contract", mode=mode, fail="cargo metadata")
            self.assertEqual(result.returncode, 4)
            self.assertNotIn(["scrut", "test", str(self.root / "cli/contracts")], self.calls())

    def test_changed_only_whole_flow_exit_and_skipped_affected(self):
        for mode in ("ci", "human", "agent"):
            with self.subTest(mode=mode):
                (self.root / "calls").unlink(missing_ok=True)
                result = self.run_flow("--changed-only", "--step=affected", "--step=typos", mode=mode)
                self.assertEqual(result.returncode, 0, result.stderr)
                self.assertEqual(self.calls(), [["cargo", "metadata", "--no-deps", "--format-version=1"]])
                result = self.run_flow("--workspace-only", "--step=affected", "--step=typos", mode=mode)
                self.assertEqual(result.returncode, 0, result.stderr)
                self.assertEqual(self.calls()[-1], ["typos", "--config", ".local/config/typos.toml"])

    def test_every_existing_step_has_complete_logs(self):
        steps = (
            "affected", "workspace", "proc-macro-tests", "fmt", "lint",
            "server-api-spec", "deny", "dependency-updates", "markdown-lint",
            "doc", "typos", "version-materialization", "graphify", "skill-lint",
            "packaging", "cli-contract",
        )
        result = self.run_flow("--workspace-only", *(f"--step={step}" for step in steps))
        self.assertEqual(result.returncode, 0, result.stderr)
        for step in steps:
            with self.subTest(step=step):
                self.assertTrue(self.log(step).is_file())
                raw = self.log(step).read_text()
                self.assertIn("==", raw)
                if step != "affected":
                    self.assertIn("tool stdout:", raw)
                    self.assertIn("tool stderr:", raw)

    def test_failed_agent_step_emits_diagnostics_without_dump(self):
        result = self.run_flow("--step=lint", mode="agent", fail="cargo clippy", diagnostics=True)
        self.assertEqual(result.returncode, 37)
        self.assertIn("warning[E0123]", result.stderr)
        self.assertIn("src/lib.rs:2:3", result.stderr)
        self.assertIn("failed; see", result.stderr)
        self.assertNotIn("failure context", result.stdout + result.stderr)
        self.assertNotIn("unmatched output", result.stdout + result.stderr)
        self.assertIn("failure context 59", self.log("lint").read_text())

    def test_log_overwrite_aliases_order_and_optional_steps(self):
        logs = self.root / ".build_logs"
        logs.mkdir()
        self.log("lint").write_text("stale lint\n")
        self.log("typos").write_text("unrelated log\n")
        result = self.run_flow("--step=dependency-update", "--step=format", "--fmt-check",
                               "--step=lint", "--step=packaging", "--step=cli-contract")
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(result.stdout.splitlines(), [
            "== Running fmt", "== Running lint", "== Running dependency-updates",
            "== Running packaging", "== Running cli-contract",
        ])
        self.assertNotIn("stale lint", self.log("lint").read_text())
        self.assertEqual(self.log("typos").read_text(), "unrelated log\n")
        self.assertFalse(self.log("format").exists())
        self.assertTrue(self.log("fmt").exists())
        self.assertEqual(self.calls()[:2], [["cargo", "fmt", "--check"],
                                          ["cargo", "sort", "--workspace", "--check", "--check-format"]])
        self.assertEqual(self.calls()[-1][0], "scrut")

    def test_immediate_options_without_tools_or_logs(self):
        for args, status in ((["--help"], 0), (["--list-steps"], 0),
                             (["--unknown"], 1), (["--step=unknown"], 1)):
            for mode in ("ci", "human", "agent"):
                result = self.run_flow(*args, mode=mode)
                self.assertEqual(result.returncode, status)
                self.assertEqual(self.calls(), [])
                self.assertFalse((self.root / ".build_logs").exists())

    def test_missing_tool_and_log_creation_failures(self):
        (self.bin / "cargo-nextest").unlink()
        # A controlled PATH excludes any host cargo-nextest but includes the
        # existing interpreter and core tools required to reach this step.
        for name in ("bash", "git", "mkdir", "tail", "python3"):
            (self.bin / name).symlink_to(shutil.which(name))
        self.env["PATH"] = str(self.bin)
        for mode in ("human", "agent"):
            result = self.run_flow("--step=workspace", mode=mode)
            self.assertEqual(result.returncode, 1)
            self.assertEqual(self.calls(), [])
            self.assertIn("cargo-nextest required", self.log("workspace").read_text())
            self.assertIn(str(self.log("workspace")), result.stderr)
            if mode == "agent":
                self.assertIn("cargo-nextest required", result.stderr)
        shutil.rmtree(self.root / ".build_logs")
        (self.root / ".build_logs").write_text("not a directory")
        result = self.run_flow("--step=lint")
        self.assertEqual(result.returncode, 1)
        self.assertIn("cannot create", result.stderr)
        self.assertEqual(self.calls(), [])
        (self.root / ".build_logs").unlink()
        self.log("lint").mkdir(parents=True)
        result = self.run_flow("--step=lint")
        self.assertEqual(result.returncode, 1)
        self.assertIn("cannot open", result.stderr)
        self.assertEqual(self.calls(), [])

    def test_presentation_helper_failures_preserve_tool_exit(self):
        for mode, helper in (("human", "tail"), ("agent", "python3")):
            path = self.bin / helper
            if helper == "python3":
                path.write_text(
                    '#!/bin/sh\ncase "$1" in *check-test-flow-diagnostics.py) exit 92;; esac\n'
                    'exec /usr/bin/python3 "$@"\n'
                )
            else:
                path.write_text("#!/bin/sh\nexit 92\n")
            path.chmod(0o755)
            result = self.run_flow("--step=lint", mode=mode, fail="cargo clippy")
            self.assertEqual(result.returncode, 37)
            self.assertIn("failed; see", result.stderr)
            self.assertIn("warning:", result.stderr)
            path.unlink()

    @unittest.skipUnless(os.environ.get("FLOW_TEST_BASELINE"), "optional pre-change CI comparison")
    def test_ci_matches_pre_change_script(self):
        baseline = self.root / "baseline-check-flow"
        shutil.copy2(os.environ["FLOW_TEST_BASELINE"], baseline)
        baseline.chmod(0o755)
        current = self.script
        cases = (
            (("--step=lint", "--step=typos"), None),
            (("--step=lint", "--step=typos"), "cargo clippy"),
            (("--step=workspace",), "cargo check"),
            (("--step=cli-contract",), "cargo metadata"),
            (("--step=affected", "--step=typos", "--changed-only"), None),
            (("--step=affected", "--step=typos", "--workspace-only"), None),
            (("--step=format", "--fmt-check", "--step=dependency-update"), None),
            (("--step=packaging", "--step=cli-contract"), None),
        )
        for args, failure in cases:
            with self.subTest(args=args, failure=failure):
                (self.root / "calls").unlink(missing_ok=True)
                before = self.run_flow(*args, mode="ci", fail=failure, diagnostics=True)
                before_calls = self.calls()
                self.script = baseline
                (self.root / "calls").unlink(missing_ok=True)
                after = self.run_flow(*args, mode="ci", fail=failure, diagnostics=True)
                self.script = current
                self.assertEqual((before.returncode, before.stdout, before.stderr),
                                 (after.returncode, after.stdout, after.stderr))
                self.assertEqual(self.calls(), before_calls)
                self.assertFalse((self.root / ".build_logs").exists())

    def test_diagnostic_formats_and_ansi_raw_preservation(self):
        lines = [
            "   Compiling fixture v1.0.0",
            "\x1b[33mwarning\x1b[0m[E001]: colored warning",
            "  --> src/lib.rs:1:2",
            " 1 | bad()",
            "   | ^^^^^",
            "   = note: context",
            "warning: `fixture` (lib) generated 1 warning",
            "Diff in src/lib.rs:3:",
            "thread 'main' panicked at 'old panic', src/lib.rs:4:5",
            "thread 'test' panicked at src/lib.rs:4:5:",
            "error: `wrng` should be `wrong`",
            "README.md:4:5: MD013 line too long",
            "warning[duplicate]: cargo-deny diagnostic",
            " WARN taplo lint diagnostic",
            " ERROR repository diagnostic",
            "::error file=README.md,line=3::annotation diagnostic",
            "error: incomplete header",
            "noise must remain only in log",
        ]
        self.log("lint").parent.mkdir()
        raw = "\n".join(lines) + "\n"
        self.log("lint").write_text(raw)
        result = subprocess.run([
            "python3", str(self.root / ".local/sbin/check-test-flow-diagnostics.py"),
            str(self.root / ".github/problem-matchers/rust.json"), str(self.log("lint")),
        ], capture_output=True, text=True, check=True)
        expected = [line for line in lines if not (
            line.startswith("   Compiling") or "generated 1 warning" in line or line.startswith("noise")
        )]
        self.assertEqual(result.stdout, "")
        self.assertEqual(result.stderr, "\n".join(expected) + "\n")
        self.assertEqual(self.log("lint").read_text(), raw)
        self.log("lint").write_text("error: no final newline")
        result = subprocess.run([
            "python3", str(self.root / ".local/sbin/check-test-flow-diagnostics.py"),
            str(self.root / ".github/problem-matchers/rust.json"), str(self.log("lint")),
        ], capture_output=True, text=True, check=True)
        self.assertEqual(result.stderr, "error: no final newline\n")
        self.assertEqual(self.log("lint").read_text(), "error: no final newline")


if __name__ == "__main__":
    unittest.main()
