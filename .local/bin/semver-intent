#!/usr/bin/env python3
"""Compare packaged release APIs with an explicitly supplied repository baseline."""
import argparse
from pathlib import Path
import subprocess
import sys
import tarfile

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
from semver_intent import analysis, commands, packages, storage
from semver_intent.model import CheckError


def parse_request():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("operation", choices=("check", "candidate"))
    parser.add_argument("--source", type=Path, required=True, help="selected repository; includes tracked and nonignored local edits")
    parser.add_argument("--target", required=True)
    parser.add_argument("--default-features", action="store_true", required=True, help="explicitly select default crate features")
    parser.add_argument("--features", action="append", default=[], help="explicit extra feature enabled for every analyzed crate; defaults are always enabled")
    parser.add_argument("--cache", type=Path, required=True)
    parser.add_argument("--baseline", type=Path)
    parser.add_argument("--output", type=Path)
    parser.add_argument("--require-tool-version", help="CI-only exact tool version requirement")
    args = parser.parse_args()
    if args.operation == "check" and (not args.baseline or args.output):
        parser.error("check requires --baseline and does not accept --output")
    if args.operation == "candidate" and (not args.output or args.baseline):
        parser.error("candidate requires --output and does not accept --baseline")
    if args.operation == "candidate" and args.require_tool_version:
        parser.error("--require-tool-version applies only to check")
    return args


def main():
    args = parse_request()
    source, cache = args.source.resolve(), args.cache.resolve()
    target, features = args.target, sorted(set(args.features))
    with storage.locked_cache(cache):
        if args.operation == "check":
            if args.require_tool_version:
                commands.require_semver_version(args.require_tool_version)
            baseline, previous = packages.baseline_root(args.baseline.resolve(), cache, target, features)
        current, candidate, intent = packages.prepare(source, cache, target, features, candidate=args.operation == "candidate")
        if args.operation == "candidate":
            output = args.output.resolve()
            storage.write_candidate(current, output)
            print(f"candidate: {output} (source {candidate['source_revision']})")
            return 0
        return analysis.compare(current, candidate, baseline, previous, intent)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (CheckError, OSError, ValueError, KeyError, tarfile.TarError, subprocess.CalledProcessError) as error:
        print(f"semver-intent: {error}", file=sys.stderr)
        sys.exit(2)
