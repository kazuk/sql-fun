#!/usr/bin/env bash
# Internal test preparation, not an additional contributor command/prerequisite.
set -euo pipefail
root=$(git rev-parse --show-toplevel)
# Use the toolchain running the contributor's checks, including an explicit
# rustup override. A probe's compiler version is not a project prerequisite.
producer=$(rustup show active-toolchain)
producer=${producer%% *}
if command -v cargo-semver-checks >/dev/null &&
  [[ "$(cargo-semver-checks --version)" == 'cargo-semver-checks 0.51.0' ]]; then
  analyzer=$(command -v cargo-semver-checks)
else
  # Keep prepared executables local to this task's build tree, never replacing
  # a contributor's installed version. Cargo's cache can serve subsequent runs.
  prepared="$root/target/package-api-tools"
  if [[ ! -x "$prepared/bin/cargo-semver-checks" ]]; then
    cargo install --locked --version 0.51.0 --root "$prepared" cargo-semver-checks >&2
  fi
  analyzer="$prepared/bin/cargo-semver-checks"
fi
jq -n --arg toolchain "$producer" --arg semver_checks "$analyzer" '{toolchain: $toolchain, semver_checks: $semver_checks}'
