#!/usr/bin/env bash
set -euo pipefail

function usage() {
  cat <<USAGE
usage: check-test-flow [options]

Options:
  --all-features
  --since=<rev>|<rev1>..<rev2>
  --workspace-only
  --changed-only
  --nextest-extra="..."
  --workspace-phase=build|test|rust-test|sqlast-test
                        Split workspace compilation and execution (CI).
  --fmt-check           Check formatting without rewriting files.
  --step=<name>          Run only the selected step. Can be repeated.
  --list-steps           Print available step names.
  -h, --help

Default steps:
  affected
  workspace
  proc-macro-tests
  fmt
  lint
  package-metadata
  server-api-spec
  deny
  dependency-updates
  markdown-lint
  doc
  typos
  version-materialization
  graphify
  skill-lint

Optional steps (explicit --step required):
  packaging
  cli-contract
  cli-e2e
  semver
USAGE
}

DEFAULT_STEPS=(
  affected
  workspace
  proc-macro-tests
  fmt
  lint
  package-metadata
  server-api-spec
  deny
  dependency-updates
  markdown-lint
  doc
  typos
  version-materialization
  graphify
  skill-lint
)

ALL_STEPS=("${DEFAULT_STEPS[@]}" packaging cli-contract cli-e2e semver)

function list_steps() {
  printf '%s\n' "${ALL_STEPS[@]}"
}

function normalize_step() {
  case "$1" in
    affected|workspace|proc-macro-tests|fmt|lint|package-metadata|server-api-spec|deny|dependency-updates|doc|typos|version-materialization|graphify|skill-lint|markdown-lint|packaging|cli-contract|cli-e2e|semver)
      printf '%s\n' "$1"
      ;;
    format)
      printf '%s\n' fmt
      ;;
    server-api|openrpc-spec)
      printf '%s\n' server-api-spec
      ;;
    dependency-update)
      printf '%s\n' dependency-updates
      ;;
    *)
      echo "unknown step: $1" >&2
      list_steps >&2
      exit 1
      ;;
  esac
}

ALL_FEATURES=0
SINCE=""
WORKSPACE_ONLY=0
CHANGED_ONLY=0
NEXTEST_EXTRA=""
WORKSPACE_PHASE=""
FMT_CHECK=0
SELECTED_STEPS=()

for a in "$@"; do
  case "$a" in
    --all-features) ALL_FEATURES=1 ;;
    --since=*)      SINCE="${a#*=}" ;;
    --workspace-only) WORKSPACE_ONLY=1 ;;
    --changed-only)   CHANGED_ONLY=1 ;;
    --nextest-extra=*) NEXTEST_EXTRA="${a#*=}" ;;
    --workspace-phase=build|--workspace-phase=test|--workspace-phase=rust-test|--workspace-phase=sqlast-test) WORKSPACE_PHASE="${a#*=}" ;;
    --fmt-check) FMT_CHECK=1 ;;
    --step=*) SELECTED_STEPS+=("$(normalize_step "${a#*=}")") ;;
    --list-steps) list_steps; exit 0 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown arg: $a" >&2; usage; exit 1 ;;
  esac
done

cd "$(git rev-parse --show-toplevel)"
GIT_ROOT="$(pwd)"
# Local verification uses binaries built for this worktree, not paths inherited
# from direnv in a different checkout. Split CI test phases supply artifacts.
if [[ "$WORKSPACE_PHASE" != test && "$WORKSPACE_PHASE" != sqlast-test && "$WORKSPACE_PHASE" != rust-test ]]; then
  target_dir=$(cargo metadata --locked --no-deps --format-version 1 | jq -er '.target_directory')
  export SQL_FUN_BIN="${target_dir}/debug/sql-fun"
  export SQL_FUN_TEST_SERVER_BIN="${target_dir}/debug/sql-fun-server"
fi
source "$GIT_ROOT/.local/sbin/workspace-nextest"
source "$GIT_ROOT/.local/sbin/workspace-verification"

declare -A STEP_SELECTED=()
if (( ${#SELECTED_STEPS[@]} > 0 )); then
  for step in "${SELECTED_STEPS[@]}"; do
    STEP_SELECTED["$step"]=1
  done
else
  for step in "${DEFAULT_STEPS[@]}"; do
    STEP_SELECTED["$step"]=1
  done
fi

# A SemVer-only invocation must analyze the selected working files unchanged.
# Other steps keep the established payload preparation before their execution.
for step in "${!STEP_SELECTED[@]}"; do
  [[ "$step" != semver ]] || continue
  echo '== Copy payload module from sql-fun-server-api to sql-fun-client'
  rm sql-fun-client/src/payloads.rs
  rm -rf sql-fun-client/src/payloads
  cp sql-fun-server-api/src/payloads.rs sql-fun-client/src/payloads.rs
  cp -r sql-fun-server-api/src/payloads sql-fun-client/src/payloads
  break
done

function step_enabled() {
  [[ -n "${STEP_SELECTED[$1]+x}" ]]
}

function require_command() {
  command -v "$1" >/dev/null || { echo "$1 required"; exit 1; }
}

FEATURES=()
[[ "$ALL_FEATURES" == "1" ]] && FEATURES+=(--all-features)


function collect_changed() {
  if [[ -n "$SINCE" ]]; then
    git diff --name-only "$SINCE"
  else
    git diff --name-only
    git diff --name-only --cached
    git ls-files --others --exclude-standard
  fi
}

function run_check()   { echo ">> cargo check $*";   cargo check   "$@"; }
function run_nextest() { echo ">> cargo nextest run $*"; cargo nextest run "$@"; }
function run_clippy() { echo ">> cargo clippy $*"; cargo clippy "$@"; }

function run_affected() {
  if (( WORKSPACE_ONLY == 1 )); then
    echo "== Skipping affected crates because --workspace-only is set."
    return
  fi

  require_command jq
  require_command cargo-nextest

  META_JSON="$(cargo metadata --no-deps --format-version=1)"
  declare -A PKG_BY_MANIFEST=()
  while read -r manifest name; do
    PKG_BY_MANIFEST["$manifest"]="$name"
  done < <(jq -r '.packages[] | "\(.manifest_path)\t\(.name)"' <<<"$META_JSON")

  mapfile -t CHANGED < <(collect_changed | grep -v '^target/' | grep -E '\.(rs|toml)$' | sort -u)

  declare -A AFFECTED=()
  for f in "${CHANGED[@]:-}"; do
    [[ -f "$f" ]] || continue
    p="$(realpath -m "$f")"
    d="$(dirname "$p")"
    while [[ "$d" != "/" ]]; do
      cand="$d/Cargo.toml"
      if [[ -f "$cand" ]]; then
        if [[ -n "${PKG_BY_MANIFEST[$cand]+x}" ]]; then
          AFFECTED["${PKG_BY_MANIFEST[$cand]}"]=1
        fi
        break
      fi
      d="$(dirname "$d")"
    done
  done

  if (( ${#AFFECTED[@]} > 0 )); then
    echo "== Affected crates: ${!AFFECTED[*]}"
    for pkg in "${!AFFECTED[@]}"; do
      run_check   -p "$pkg" "${FEATURES[@]}"
      run_workspace_nextest -p "$pkg" "${FEATURES[@]}" ${NEXTEST_EXTRA}  --no-tests pass
      run_clippy  -p "$pkg" "${FEATURES[@]}" --no-deps --all-targets \
        -- -D warnings --allow unfulfilled_lint_expectations
    done
  else
    echo "== No affected crates detected."
    if (( CHANGED_ONLY == 1 )); then
      exit 0
    fi
  fi
}

function run_sqlast_feature_boundaries() {
  echo "== sqlast SQLite workaround feature boundaries"
  # Separate Cargo invocations avoid workspace feature unification hiding opt-out.
  run_check -p sql-fun-sqlast --all-targets --no-default-features
  run_check -p sql-fun-sqlast --all-targets --no-default-features --features sqlite
  run_check -p sql-fun-sqlast --all-targets --no-default-features --features turso_parser
  run_check -p sql-fun-sqlast --all-targets --features workaround_turso_9791
}

function run_cli_dependency_boundaries() {
  echo "== CLI SQLAST dependency boundary (including test/build dependencies)"
  local tree mode
  local -a features=()
  for mode in default sqlite; do
    features=()
    if [[ "$mode" == sqlite ]]; then
      features=(--features sqlite)
    fi
    tree="$(cargo tree --locked -p sql-fun-cli --edges normal,build,dev "${features[@]}")"
    case "$tree" in
      *sql-fun-sqlast*)
        echo "CLI $mode dependency graph includes sql-fun-sqlast" >&2
        return 1
        ;;
    esac
    # Keep package selections separate from workspace feature unification.
    run_check -p sql-fun-cli --all-targets "${features[@]}"
  done
}

function run_workspace_build_checks() {
  if [[ "$WORKSPACE_PHASE" == "build" && -n "${SQL_FUN_CI_TEST_GROUP:-}" ]]; then
    case "$SQL_FUN_CI_TEST_GROUP" in
      a)
        run_cli_dependency_boundaries
        run_check --workspace "${FEATURES[@]}"
        ;;
      b) run_sqlast_feature_boundaries ;;
      *) echo "Unknown workspace test group: $SQL_FUN_CI_TEST_GROUP" >&2; return 1 ;;
    esac
  else
    run_sqlast_feature_boundaries
    run_cli_dependency_boundaries
    run_check --workspace "${FEATURES[@]}"
  fi
}

function run_proc_macro_tests() {
  require_command cargo-nextest
  echo "== Proc-macro compilation tests"
  run_nextest -p sql-fun "${FEATURES[@]}" ${NEXTEST_EXTRA} --no-tests pass
}

function run_fmt() {
  if (( FMT_CHECK == 1 )); then
    echo "== Checking formatting"
    cargo fmt --check
    cargo sort --workspace --check --check-format
  else
    echo "== Formatting sources"
    cargo fmt
    cargo sort --workspace
  fi
}

function run_lint() {
  echo "== Linting"
  cargo clippy --no-deps --workspace --all-targets "${FEATURES[@]}" \
    -- -D warnings --allow unfulfilled_lint_expectations
  RUST_LOG=error taplo lint
}

function run_server_api_spec() {
  echo "== Generate server API spec document"
  cargo run -p sql-fun-server-api --features openrpc-schema,bin-deps \
    --bin openrpc-spec -- \
    --output-path "${GIT_ROOT}/server_api_spec.json" \
    --force
}

function run_deny() {
  echo "== check dependencies"
  cargo deny check
}

function run_dependency_updates() {
  echo "== check dependency updates"
  cargo upgrade --dry-run --compatible ignore --incompatible allow
}

function run_doc() {
  require_command mdbook
  echo "== Document build"
  cargo doc --workspace --no-deps
  mdbook build
  echo "== Documentation tests (default and all features)"
  cargo test --doc -p sql-fun-sqlast -p sql-fun-client
  cargo test --doc -p sql-fun-sqlast -p sql-fun-client --all-features
}

function run_typos() {
  echo "== Check typos"
  typos --config .local/config/typos.toml
}

function run_version_materialization() {
  # Unbudgeted materialization test removed in 83b2c46b; recover from Git history.
  echo "== Verify release version materialization"
  "${GIT_ROOT}/.local/bin/test-release-publication"
  "${GIT_ROOT}/.local/bin/test-release-preparation"
  "${GIT_ROOT}/.local/bin/test-materialize-release-state"
}

function run_packaging() {
  echo "== Build and validate Linux distributions"
  "${GIT_ROOT}/.local/bin/package-linux" x86_64-unknown-linux-gnu
}

function run_package_metadata() {
  "${GIT_ROOT}/.local/sbin/package-release-sources" > /dev/null
}

function run_semver() {
  local tools toolchain target
  tools="$("${GIT_ROOT}/.local/sbin/prepare-package-api-tests")"
  toolchain="$(jq -er .toolchain <<< "$tools")"
  target="$(rustup run "$toolchain" rustc -vV | sed -n 's/^host: //p')"
  "${GIT_ROOT}/.local/bin/check-semver" --repository "$GIT_ROOT" --working-tree \
    --toolchain "$toolchain" --target "$target"
}

function run_cli_contract() {
  require_command jq
  require_command scrut
  echo "== CLI contracts"
  cargo build --locked -p sql-fun-cli --bin sql-fun
  target_dir=$(cargo metadata --locked --no-deps --format-version 1 | jq -er '.target_directory')
  BASH_ENV="${GIT_ROOT}/cli/contracts/setup.sh" \
    SQL_FUN_BIN="${target_dir}/debug/sql-fun" \
    scrut test "${GIT_ROOT}/cli/contracts"
}

function run_cli_e2e() {
  require_command jq
  require_command scrut
  echo "== Scrut CLI E2E tests"
  cargo build --locked -p sql-fun-cli --bin sql-fun "${FEATURES[@]}"
  cargo build --locked -p sql-fun-server --bin sql-fun-server "${FEATURES[@]}"
  local target_dir
  target_dir=$(cargo metadata --locked --no-deps --format-version 1 | jq -er '.target_directory')
  SQL_FUN_BIN="${target_dir}/debug/sql-fun" \
    SQL_FUN_TEST_SERVER_BIN="${target_dir}/debug/sql-fun-server" \
    "${GIT_ROOT}/cli/tests/scrut/run.sh" cli/tests/scrut
}

function run_graphify() {
  require_command graphify
  echo "== Update graph index"
  graphify update .
}

function run_skill_validator() {
  require_command skill-validator
  echo "== Linting skills"
  # Repository skills may include a maintainer-facing README.md when SKILL.md
  # links to it, such as the third-party vendoring workflow.
  skill-validator check --strict --allow-flat-layouts --emit-annotations .codex/skills --output compact
}

function run_rumdl() {
  require_command rumdl
  echo "== Linting Markdown"

  # Gitlinks identify submodules even when they have not been initialized.
  local entry
  local -a excludes=()
  while IFS= read -r -d '' entry; do
    [[ "$entry" == "160000 "* ]] || continue
    excludes+=("${entry#*$'\t'}/**")
  done < <(git ls-files --stage -z)

  local -a options=()
  if (( ${#excludes[@]} > 0 )); then
    local IFS=,
    options=(--exclude "${excludes[*]}")
  fi
  rumdl check "${options[@]}" .
}

for step in "${ALL_STEPS[@]}"; do
  if step_enabled "$step"; then
    case "$step" in
      affected) run_affected ;;
      workspace) run_workspace ;;
      proc-macro-tests) run_proc_macro_tests ;;
      fmt) run_fmt ;;
      lint) run_lint ;;
      package-metadata) run_package_metadata ;;
      server-api-spec) run_server_api_spec ;;
      deny) run_deny ;;
      dependency-updates) run_dependency_updates ;;
      doc) run_doc ;;
      typos) run_typos ;;
      version-materialization) run_version_materialization ;;
      graphify) run_graphify ;;
      skill-lint) run_skill_validator ;;
      markdown-lint) run_rumdl ;;
      packaging) run_packaging ;;
      cli-contract) run_cli_contract ;;
      cli-e2e) run_cli_e2e ;;
      semver) run_semver ;;
    esac
  fi
done
