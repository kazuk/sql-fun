#!/bin/bash
set -euo pipefail

TOPN="${TOPN:-20}"

cargo llvm-cov nextest --workspace --all-features

if ! command -v jq >/dev/null 2>&1; then
  echo "jq not found" >&2
  exit 127
fi

json="$(
  cargo llvm-cov report --json --summary-only "$@"
)"

jq -r --argjson topn "$TOPN" '
def fs:
  {
    filename: .filename,
    total: (.summary.lines.count // 0),
    covered: (.summary.lines.covered // 0),
    uncovered: ((.summary.lines.count // 0) - (.summary.lines.covered // 0)),
    percent: (.summary.lines.percent // 0)
  };

[
  .data[]?.files[]? | fs
]
| group_by(.filename)
| map({
    filename: .[0].filename,
    total: (map(.total) | max),
    uncovered: (map(.uncovered) | max),
    percent: (map(.percent) | min)
  })
| map(select(.total > 0 and .uncovered > 0))
| sort_by(.uncovered) | reverse
| .[:$topn]
| .[]
| "\(.uncovered)\t\(.total)\t\(.percent)\t\(.filename)"
' <<<"$json" | column -t
