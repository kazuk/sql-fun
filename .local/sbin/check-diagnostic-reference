#!/usr/bin/env python3
"""Bounded, fail-closed source classifier and Markdown coverage validation.

No compilation or SQL execution. Unknown classifier expressions require review;
code strings are always taken from Rust, never from a parallel registry.
"""
import json
from pathlib import Path
import re
import sys
import tomllib


class InvalidSource(ValueError):
    pass


def lex(source):
    """Keep every code token; comments and literal braces cannot alter groups."""
    pattern = re.compile(r'"(?:\\.|[^"\\])*"|\'(?:\\.|[^\'\\])\'|[A-Za-z_][A-Za-z_0-9]*|::|=>|\.\.|[^\s]', re.S)
    raw_pattern = re.compile(r'(?:br|r)(#*)"')
    result = []
    i = 0
    while i < len(source):
        if source[i].isspace():
            i += 1
        elif source.startswith('//', i):
            newline = source.find('\n', i)
            i = len(source) if newline < 0 else newline
        elif source.startswith('/*', i):
            depth = 1
            i += 2
            while depth:
                if i == len(source):
                    raise InvalidSource('unterminated Rust comment')
                if source.startswith('/*', i):
                    depth += 1
                    i += 2
                elif source.startswith('*/', i):
                    depth -= 1
                    i += 2
                else:
                    i += 1
        else:
            raw = raw_pattern.match(source, i)
            if raw:
                marker = '"' + raw[1]
                closing = source.find(marker, raw.end())
                if closing < 0:
                    raise InvalidSource('unterminated Rust raw string')
                stop = closing + len(marker)
                result.append(source[i:stop])
                i = stop
            else:
                token = pattern.match(source, i)
                if token is None:
                    raise InvalidSource('unrecognized Rust token')
                result.append(token[0])
                i = token.end()
    return result


def end(ts, start):
    closing = {'(': ')', '[': ']', '{': '}'}[ts[start]]
    i = start + 1
    while i < len(ts):
        if ts[i] == closing:
            return i + 1
        i = end(ts, i) if ts[i] in ('(', '[', '{') else i + 1
    raise InvalidSource('unbalanced Rust group')


def production(ts):
    result = []
    i = 0
    marker = lex('#[cfg(test)]')
    while i < len(ts):
        if ts[i:i + len(marker)] == marker:
            i += len(marker)
            if i + 1 < len(ts) and ts[i + 1] == ':':
                while ts[i] != ',':
                    i += 1
                i += 1
                continue
            while i < len(ts) and ts[i] not in ('{', ';'):
                i += 1
            if i == len(ts):
                raise InvalidSource('incomplete test-only item')
            i = end(ts, i) if ts[i] == '{' else i + 1
        else:
            result.append(ts[i])
            i += 1
    return result


def split(ts):
    parts = []
    start = i = 0
    while i < len(ts):
        if ts[i] in ('(', '[', '{'):
            i = end(ts, i)
        elif ts[i] == ',':
            parts.append(ts[start:i])
            start = i = i + 1
        else:
            i += 1
    if ts[start:]:
        parts.append(ts[start:])
    return parts


def has_import(ts, path):
    """Match an unaliased module-level import, including nested use groups."""
    target = lex(path)

    def matches(items, prefix):
        if '{' not in items:
            return prefix + items == target
        group = items.index('{')
        if end(items, group) != len(items):
            return False
        return any(matches(part, prefix + items[:group])
                   for part in split(items[group + 1:-1]))

    i = 0
    while i < len(ts):
        if ts[i] == 'use':
            stop = i + 1
            while ts[stop] != ';':
                stop = end(ts, stop) if ts[stop] in ('(', '[', '{') else stop + 1
            if matches(ts[i + 1:stop], []):
                return True
            i = stop + 1
        else:
            i = end(ts, i) if ts[i] in ('(', '[', '{') else i + 1
    return False


# Variant/constructor identities, not a duplicate code-string registry.
# Evidence and reasons: docs/internal-rules/diagnostic-reference-inventory.md.
UNEMITTED = {
    'AnalysisProblem': {
        'ExtensionNotFound': 'extension_not_found',
        'NullabilityUnknown': 'nullability_unknown',
        'ArgumentTypeMismatch': 'argument_type_mismatch',
        'CaseWhenExprTypeUnknown': 'case_when_type_unknown',
    },
    'NameResolution': {'UndefinedColumn': None},
    'TableFunctionProblem': {'CollationNotFound': 'collation_not_found'},
}


def match_arms(body):
    arms = []
    i = 0
    while i < len(body):
        start = i
        arrow = body.index('=>', i)
        i = arrow + 1
        if body[i] == '{':
            i = end(body, i)
        else:
            while i < len(body) and body[i] != ',':
                i = end(body, i) if body[i] in ('(', '[') else i + 1
        arms.append(body[start:i])
        if i < len(body) and body[i] == ',':
            i += 1
    return arms


# Source-symbol counts guard exclusion proofs and the dynamic ownership
# boundary, not code strings. New imports, aliases, Self::variant references
# and constructor calls require a source review; unrelated edits do not.
