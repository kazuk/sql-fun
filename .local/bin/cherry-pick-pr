#!/bin/bash
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: cherry-pick-pr [--draft] [--no-editor]

Cherry-pick the current commit onto origin/main, push it, and create a pull request.

Options:
  --draft      Create the pull request as a draft.
  --no-editor  Create the pull request without opening $VISUAL or $EDITOR.
  -h, --help  Show this help message.
EOF
}

PR_CREATE_ARGS=(--base main --fill)
OPEN_EDITOR=true

while (($#)); do
    case "$1" in
        --draft)
            PR_CREATE_ARGS+=(--draft)
            ;;
        --no-editor)
            OPEN_EDITOR=false
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
    shift
done

if "$OPEN_EDITOR"; then
    PR_CREATE_ARGS+=(--editor)
fi

COMMIT_SHA=$(git -C "$GIT_ROOT" rev-parse HEAD)

git -C "$GIT_ROOT" --no-pager log -1 --stat --decorate --format=fuller
read -r -p "Cherry-pick this commit and create a PR? [y/N] " answer

case "$answer" in
    y|Y|yes|Yes|YES) ;;
    *)
        echo "Aborted."
        exit 0
        ;;
esac

BRANCH_NAME="cherry-pick/${COMMIT_SHA}"
WORKTREE_PATH="${GIT_ROOT}/.worktrees/${COMMIT_SHA}"

mkdir -p "${GIT_ROOT}/.worktrees"
git -C "$GIT_ROOT" fetch origin main
git -C "$GIT_ROOT" worktree add -b "$BRANCH_NAME" "$WORKTREE_PATH" origin/main
git -C "$WORKTREE_PATH" cherry-pick "$COMMIT_SHA"
git -C "$WORKTREE_PATH" push -u origin "$BRANCH_NAME"
cd "$WORKTREE_PATH"
gh pr create "${PR_CREATE_ARGS[@]}"

cd "$GIT_ROOT"
git worktree remove "$WORKTREE_PATH"
