#!/bin/bash

# [semver](https://github.com/masa213f/semver)

PACKAGE=${1}
MODE=${2}

CURRENT_VERSION=$(cargo metadata --format-version 1 | jq -r '.packages[] | select(.name=="sql-fun") | .version')
CURRENT_MAJOR=$(semver --json ${CURRENT_VERSION} | jq '.major')

if [ $CURRENT_MAJOR -eq 0 ] ; then
    case "${MODE}" in
      "major")
        echo ${CURRENT_VERSION} | semver-bump minor
        ;;
      "minor")
        echo ${CURRENT_VERSION} | semver-bump patch
        ;;
      "patch")
        echo ${CURRENT_VERSION} | semver-bump patch
        ;;
    esac
else
    echo ${CURRENT_VERSION} | semver-bump ${MODE}
fi
