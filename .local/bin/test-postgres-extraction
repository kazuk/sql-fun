#!/usr/bin/env python3
"""Exercise installed extraction contracts using exclusively task-owned PostgreSQL containers."""
import argparse
import errno
import fcntl
import pty
import re
import select
import struct
import termios
import hashlib
import io
import json
import os
from pathlib import Path
import secrets
import shutil
import subprocess
import time
import tarfile

TYPE_QUERY = (Path(__file__).resolve().parents[2] / "cli/src/extract/sql/builtin_types.sql").read_text()

IMAGES = {
    "17": "postgres@sha256:29e0bb09c8e7e7fc265ea9f4367de9622e55bae6b0b97e7cce740c2d63c2ebc0",
    "18": "postgres@sha256:5773fe724c49c42a7a9ca70202e11e1dff21fb7235b335a73f39297d200b73a2",
}


def run(*args, data=None, env=None, success=True):
    result = subprocess.run(args, input=data, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                            env=env, timeout=180, check=False)
    if success and result.returncode:
        raise RuntimeError(f"{args[0]} failed: {result.stderr.decode(errors='replace')}")
    if not success:
        assert result.returncode != 0, "expected failure"
    return result


def payload(directory):
    return {str(p.relative_to(directory)): hashlib.sha256(p.read_bytes()).hexdigest()
            for p in directory.rglob("*") if p.is_file() and p.name != "metadata.json"}


def owned():
    return set(run("docker", "ps", "-aq", "--filter", "label=io.sql-fun.extraction=owned").stdout.split())


def validate_interactive_init(binary, destination, fixture, declarations, ambient_metadata=False):
    """Bare init must not inspect project contents or ambient metadata paths."""
    project = destination / f"interactive-init-{fixture}"
    project.mkdir()
    manifest = project / "Cargo.toml"
    manifest.write_text(declarations)
    home = project / "chosen-home"
    env = dict(os.environ, SQL_FUN_HOME=str(home), TERM="xterm", PATH=str(project / "no-tools"))
    env.pop("SQL_FUN_DATASOURCE", None)
    env.pop("SQL_FUN_METADATA_FILE", None)
    if ambient_metadata:
        env["SQL_FUN_METADATA_FILE"] = str(manifest)
    master, slave = pty.openpty()
    fcntl.ioctl(slave, termios.TIOCSWINSZ, struct.pack("HHHH", 24, 100, 0, 0))

    def terminal_session():
        os.setsid()
        fcntl.ioctl(0, termios.TIOCSCTTY, 0)

    process = subprocess.Popen([binary, "init"],
                               cwd=project, env=env, stdin=slave, stdout=slave,
                               stderr=slave, preexec_fn=terminal_session)
    os.close(slave)
    transcript = bytearray()

    def rendered(since=0):
        return re.sub(rb"\x1b\[[0-?]*[ -/]*[@-~]", b"", transcript[since:])

    def wait_for(marker, since=0):
        deadline = time.monotonic() + 15
        while marker.encode() not in rendered(since):
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise AssertionError(f"terminal did not reach {marker!r}: {transcript!r}")
            ready, _, _ = select.select([master], [], [], min(remaining, 1))
            if ready:
                try:
                    chunk = os.read(master, 65536)
                except OSError as error:
                    if error.errno == errno.EIO:
                        raise AssertionError(f"terminal exited before {marker!r}: {transcript!r}") from error
                    raise
                if not chunk:
                    raise AssertionError(f"terminal closed before {marker!r}: {transcript!r}")
                transcript.extend(chunk)

    try:
        wait_for("Initialize sql-fun development support?")
        os.write(master, b"y\r")
        wait_for("sql-fun home directory (SQL_FUN_HOME)?")
        assert b"Choose engines" not in rendered(), "home choice must appear first"
        os.write(master, b"\r")  # Explicitly accept the SQL_FUN_HOME suggestion.
        wait_for(f"Use {home}")
        assert not home.exists(), "home must not be created before path confirmation"
        os.write(master, b"y\r")  # Confirm the resolved absolute home path.
        wait_for("Space to select, Enter to confirm.")
        wait_for("[ ] postgres")
        wait_for("[ ] sqlite")
        assert b"Choose datasources" not in rendered(), "bare init must not inspect project metadata"
        start = len(transcript)
        os.write(master, b"\r")
        wait_for("Select at least one option explicitly.", start)
        wait_for("Space to select, Enter to confirm.", start)
        os.write(master, b"\x1b[B \r")  # Move to SQLite, select, and confirm.
        wait_for("SQLite development-support setup is still under development.")
        assert process.wait(timeout=15) == 0
        assert home.is_dir() and not (home / "postgres").exists()
        assert manifest.read_text() == declarations, "init must not rewrite project metadata"
    finally:
        if process.poll() is None:
            process.terminate()
            process.wait(timeout=5)
        os.close(master)
    print(f"Interactive init ({fixture}): no project inspection, home choice and explicit engine selection passed", flush=True)


def validate_masters(directory):
    collations = json.loads((directory / "collations.json").read_text())
    classes = json.loads((directory / "operator_classes.json").read_text())
    database = collations["database"]
    default = database["default_collation"]
    assert any(all(c[k] == default[k] for k in ("schema", "name", "encoding"))
               and c["provider"] == "d" for c in collations["collations"])
    assert database["encoding_name"] == "UTF8"
    assert any(c["name"] == "C" and c["encoding"] == -1 for c in collations["collations"])
    assert any(c["name"] == "int4_ops" and c["access_method"] == "btree"
               and c["default"] and c["family"]["name"] == "integer_ops"
               and c["input_type"] == {"schema": "pg_catalog", "name": "int4"}
               and c["key_type"] is None for c in classes)
    assert any(c["key_type"] is not None for c in classes)
    return collations, classes


def base_type_sql(schema, name, collatable):
    def ident(value):
        return '"' + value.replace('"', '""') + '"'
    ty = f"{ident(schema)}.{ident(name)}"
    input_fn = f"{ident(schema)}.{ident(name + '_in')}"
    output_fn = f"{ident(schema)}.{ident(name + '_out')}"
    return f'''CREATE TYPE {ty};
CREATE FUNCTION {input_fn}(cstring) RETURNS {ty} AS 'textin' LANGUAGE internal IMMUTABLE STRICT;
CREATE FUNCTION {output_fn}({ty}) RETURNS cstring AS 'textout' LANGUAGE internal IMMUTABLE STRICT;
CREATE TYPE {ty} (INPUT={input_fn}, OUTPUT={output_fn}, INTERNALLENGTH=variable,
 STORAGE=extended, COLLATABLE={str(collatable).lower()});
'''


def validate_type_facts(directory):
    rows = json.loads((directory / "pg_type.json").read_text())
    facts = {(row["schema"], row["name"]): row["collatable"] for row in rows}
    assert len(facts) == len(rows), "duplicate qualified type identity"
    assert all(row["collatable"] is None or type(row["collatable"]) is bool for row in rows)
    assert {name: facts[("pg_catalog", name)] for name in ("text", "name", "int4", "int2vector")} == {
        "text": True, "name": True, "int4": False, "int2vector": False}
    return rows, facts


def validate_shell_selection(identifier):
    # Substitute only the source relation to exercise the real producer query
    # without changing PostgreSQL system catalogs or depending on bootstrap shells.
    source = '''source_types(oid, typnamespace, typtype, typname, typisdefined,
        typcategory, typcollation, typarray) AS (
      VALUES (42::oid, 'pg_catalog'::regnamespace::oid, 'p', 'shell', false, NULL::text, 0::oid, 0::oid),
             (43::oid, 'pg_catalog'::regnamespace::oid, 'p', '__excluded', false, NULL::text, 0::oid, 0::oid),
             (44::oid, 'pg_catalog'::regnamespace::oid, 'b', 'defined', true, 'S', 100::oid, 45::oid),
             (45::oid, 'pg_catalog'::regnamespace::oid, 'b', '_defined', true, 'A', 100::oid, 0::oid)
    ), bootstrap'''
    query = TYPE_QUERY.replace("pg_catalog.pg_type", "source_types").replace("WITH bootstrap", "WITH " + source)
    result = run("docker", "exec", "-i", identifier, "psql", "-X", "-qAt", "-U", "postgres",
                 "-v", "ON_ERROR_STOP=1", data=query.encode())
    rows = json.loads(result.stdout)
    assert rows == [
        {"schema": "pg_catalog", "name": "shell", "category": None, "collatable": None},
        {"schema": "pg_catalog", "name": "defined", "category": "S", "collatable": True},
    ], "shell-null facts or existing eligibility changed"


def validate_installed_type_facts(builtin, baseline, schema, other, extension_schema):
    rows, facts = validate_type_facts(builtin)
    assert facts[(schema, "Base 雪")] is True
    assert facts[(other, "Base 雪")] is False
    assert facts[("pg_catalog", "Normal OID Type")] is True
    assert facts[(extension_schema, "citext")] is True
    assert facts[(extension_schema, "hstore")] is False
    assert (schema, "_Base 雪") not in facts, "ordinary arrays must retain their existing representation"
    baseline_identities = {(row["schema"], row["name"]) for row in
                           json.loads((baseline / "pg_type.json").read_text())}
    additional = [(row["schema"], row["name"]) for row in rows if (row["schema"], row["name"]) not in
                  baseline_identities]
    assert additional == sorted(additional), "installed types must have deterministic qualified ordering"


def validate_selected_masters(binary, major, destination, environment, bundle_file, identifier):
    validate_shell_selection(identifier)
    # Include quotes, backslashes, SQL punctuation and Unicode in exact CLI inputs.
    schema = "Odd'\\\"; -- 雪"
    other = "other masters"
    extension_schema = "extension masters"
    quoted = '"' + schema.replace('"', '""') + '"'
    sql = f'''CREATE SCHEMA {quoted};
CREATE SCHEMA "other masters";
CREATE SCHEMA "extension masters";
CREATE EXTENSION btree_gin SCHEMA "extension masters";
CREATE EXTENSION citext SCHEMA "extension masters";
CREATE EXTENSION hstore SCHEMA "extension masters";
CREATE DOMAIN "other masters"."Type 雪" AS integer;
CREATE OPERATOR FAMILY "other masters"."Family 雪" USING btree;
CREATE OPERATOR CLASS {quoted}."Same 雪" FOR TYPE "other masters"."Type 雪"
 USING btree FAMILY "other masters"."Family 雪" AS
 OPERATOR 1 < (integer,integer), OPERATOR 3 = (integer,integer),
 FUNCTION 1 btint4cmp(integer,integer);
CREATE OPERATOR CLASS {quoted}."Same 雪" FOR TYPE integer USING hash AS
 OPERATOR 1 = (integer,integer), FUNCTION 1 hashint4(integer);
CREATE COLLATION {quoted}."Name 雪" FROM pg_catalog."C";
CREATE COLLATION "other masters"."Name 雪" FROM pg_catalog."C";
CREATE COLLATION {quoted}."Encoding" (provider=libc, locale='C');
CREATE COLLATION pg_catalog."not a builtin" FROM pg_catalog."C";
'''
    sql += base_type_sql(schema, "Base 雪", True)
    sql += base_type_sql(other, "Base 雪", False)
    sql += base_type_sql("pg_catalog", "Normal OID Type", True)
    run("docker", "exec", "-i", identifier, "psql", "-X", "-U", "postgres",
        "-v", "ON_ERROR_STOP=1", data=sql.encode())
    builtin = destination / f"{major}-masters-builtin"
    run(binary, "extract", "catalog", "--output", str(builtin), env=environment)
    baseline = payload(destination / f"{major}-restricted")
    for filename, digest in baseline.items():
        if filename != "pg_type.json":
            assert payload(builtin)[filename] == digest, "type scope changed another catalog"
    validate_installed_type_facts(builtin, destination / f"{major}-restricted", schema, other, extension_schema)
    selected = destination / f"{major}-selected-masters"
    options = ["--definition-schema", schema, "--definition-schema", extension_schema]
    run(binary, "extract", "catalog", *options, "--output", str(selected), env=environment)
    collations, classes = validate_masters(selected)
    metadata = json.loads((selected / "metadata.json").read_text())
    assert metadata["format_version"] == 1
    assert metadata["definition_schemas"] == sorted([schema, extension_schema])
    for filename, digest in payload(builtin).items():
        if filename not in ("collations.json", "operator_classes.json"):
            assert payload(selected)[filename] == digest, "additional scope changed existing catalogs"
    assert {c["schema"] for c in collations["collations"]} == {"pg_catalog", schema}
    encoding_variants = [c["encoding"] for c in collations["collations"]
                         if c["schema"] == schema and c["name"] == "Encoding"]
    assert encoding_variants == [6], "database-specific encoding must be retained"
    named = [c for c in classes if c["schema"] == schema and c["name"] == "Same 雪"]
    assert {c["access_method"] for c in named} == {"btree", "hash"}
    btree = next(c for c in named if c["access_method"] == "btree")
    assert btree["input_type"] == {"schema": other, "name": "Type 雪"}
    assert btree["family"] == {"schema": other, "name": "Family 雪", "access_method": "btree"}
    assert not btree["default"]
    assert any(c["schema"] == extension_schema for c in classes), "installed extension masters lost"
    assert not any(c["schema"] == other for c in classes), "references must not broaden selection"
    repeated = destination / f"{major}-selected-repeat"
    run(binary, "extract", "catalog", "--definition-schema", extension_schema,
        "--definition-schema", schema, "--definition-schema", schema,
        "--output", str(repeated), env=environment)
    assert payload(repeated) == payload(selected)
    assert (repeated / "metadata.json").read_bytes() == (selected / "metadata.json").read_bytes()
    imported = destination / f"{major}-selected-imported"
    run(binary, "extract", "import-extensions", "--catalog", str(selected), "--bundle", str(bundle_file),
        "--output", str(imported), env=environment)
    for name in ("collations.json", "operator_classes.json", "metadata.json"):
        assert (imported / name).read_bytes() == (selected / name).read_bytes()
    missing = destination / f"{major}-missing-schema"
    run(binary, "extract", "catalog", "--definition-schema", "unselected missing schema",
        "--output", str(missing), env=environment, success=False)
    assert not missing.exists(), "invalid scope published partial output"
    print(f"PostgreSQL {major}: exact schema scope, encoding variants, cross-schema references and extension masters passed", flush=True)


def validate(binary, major, image, destination, host, bind):
    output = destination / major
    run(binary, "extract", "catalog", "--docker-image", image,
        "--docker-host-address", host, "--docker-bind-address", bind, "--output", str(output))
    validate_type_facts(output)
    types = {row["name"]: row["category"] for row in json.loads((output / "pg_type.json").read_text())}
    assert all(isinstance(code, str) and len(code) == 1 for code in types.values())
    assert {name: types[name] for name in ("char", "unknown", "_record", "int4range")} == {
        "char": "Z", "unknown": "X", "_record": "P", "int4range": "R"}
    functions = json.loads((output / "functions.json").read_text())
    clock = next(f for f in functions if f["name"] == "clock_timestamp")
    assert clock["overloads"][0]["args"] == [], "zero-argument functions must not have a null argument"
    for name, kind, returns_set in (("lower", "f", False), ("bool_and", "a", False), ("pg_ls_dir", "f", True)):
        definition = next(function for function in functions if function["name"] == name)
        assert all(overload["kind"] == kind and overload["returns_set"] == returns_set
                   for overload in definition["overloads"]), f"incorrect view row properties: {name}"
    schema = (output / "schema.sql").read_text()
    assert "ON UPDATE TO pg_catalog.pg_settings DO INSTEAD NOTHING;" in schema
    assert '"pg_stats" WITH (security_barrier' in schema
    validate_masters(output)
    first = payload(output)
    assert "extension/uuid-ossp.control" in first
    assert json.loads((output / "metadata.json").read_text())["server_version_num"] // 10000 == int(major)
    password = secrets.token_hex(24)
    # Only this newly created container is used as the externally supplied server.
    identifier = run("docker", "create", "--label", "io.sql-fun.extraction=owned",
                     "-e", f"POSTGRES_PASSWORD={password}", "-p", f"{bind}::5432", image).stdout.decode().strip()
    try:
        run("docker", "start", identifier)
        deadline = time.monotonic() + 60
        while True:
            # The image briefly starts a Unix-socket-only bootstrap server.
            # Wait for TCP readiness of the final server before supplying its URL.
            ready = subprocess.run(["docker", "exec", identifier, "pg_isready", "-h", "127.0.0.1", "-U", "postgres"],
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
            if ready.returncode == 0:
                break
            assert time.monotonic() < deadline, "PostgreSQL readiness timed out"
            time.sleep(0.25)
        ports = json.loads(run("docker", "inspect", "--format", "{{json .NetworkSettings.Ports}}", identifier).stdout)
        port = ports["5432/tcp"][0]["HostPort"]
        connection_env = dict(os.environ, SQL_FUN_DATABASE_URL=f"postgresql://postgres:{password}@{host}:{port}/postgres?sslmode=disable",
                              DOCKER_HOST="unix:///nonexistent-sql-fun-test.sock")
        # Type I/O functions with cstring signatures are SQL-callable with unknown literals.
        result = run("psql", "-X", "-qAtw", "--dbname", connection_env["SQL_FUN_DATABASE_URL"],
                     "--set=ON_ERROR_STOP=1", data=b"SELECT boolin('true'), int4in('42'), int4out(42);\n")
        assert result.stdout.strip() == b"t|42|42"
        existing = destination / f"{major}-connection"
        existing.mkdir()  # Existing empty output is supported.
        run(binary, "extract", "catalog", "--output", str(existing), env=connection_env)
        init_home = destination / f"{major}-initialized-connection"
        run(binary, "init", "--yes", "--sql-fun-home", str(init_home), "--engines", "postgres", "--database-url", connection_env["SQL_FUN_DATABASE_URL"], "--engine-versions", major, env=connection_env)
        installed = init_home / "postgres" / major
        assert payload(installed) == payload(existing), "init must install the same catalog used by extraction"
        previous_install = payload(installed)
        run(binary, "init", "--yes", "--sql-fun-home", str(init_home), "--engines", "postgres", "--database-url", connection_env["SQL_FUN_DATABASE_URL"], "--engine-versions", major, env=connection_env)
        assert payload(installed) == previous_install, "rerun modified a valid installation"
        other = "18" if major == "17" else "17"
        run(binary, "init", "--yes", "--sql-fun-home", str(init_home),
            "--engines", "postgres", "--database-url", connection_env["SQL_FUN_DATABASE_URL"], "--engine-versions", other, env=connection_env, success=False)
        script = run(binary, "extract", "export-script").stdout
        bundle = run("docker", "exec", "-i", identifier, "sh", "-s", data=script).stdout
        assert bundle == run("docker", "exec", "-i", identifier, "sh", "-s", data=script).stdout
        bundle_file = destination / f"{major}.tar"
        bundle_file.write_bytes(bundle)
        run(binary, "extract", "import-extensions", "--bundle", str(bundle_file), "--catalog", str(existing), "--output", str(destination / f"{major}-imported"), env=connection_env)
        assert payload(destination / f"{major}-imported") == first, "Docker and supplied-connection payloads differ"
        # Installed extensions and user-defined objects must not become builtins.
        run("docker", "exec", "-i", identifier, "psql", "-X", "-U", "postgres", "-v", "ON_ERROR_STOP=1",
            data=b'''CREATE EXTENSION "uuid-ossp";
CREATE SCHEMA "odd schema";
CREATE DOMAIN "odd schema"."a""b" AS text;
CREATE FUNCTION pg_catalog."Unusual Function"(text) RETURNS text LANGUAGE sql AS 'SELECT $1';
CREATE ROLE extractor LOGIN PASSWORD 'extractor-test';
GRANT CONNECT ON DATABASE postgres TO extractor;
''')
        limited_env = dict(connection_env, SQL_FUN_DATABASE_URL=f"postgresql://extractor:extractor-test@{host}:{port}/postgres?sslmode=disable")
        existing = destination / f"{major}-restricted"
        run(binary, "extract", "catalog", "--output", str(existing), env=limited_env)
        assert not (existing / "extension").exists(), "catalog-only extraction must not retain stale extension files"
        run(binary, "extract", "import-extensions", "--bundle", str(bundle_file), "--catalog", str(existing), "--output", str(destination / f"{major}-restricted-imported"), env=limited_env)
        assert payload(destination / f"{major}-restricted-imported") == first, "user or extension objects contaminated builtin metadata"
        validate_selected_masters(binary, major, destination, limited_env, bundle_file, identifier)
        previous = payload(existing)
        failed = run(binary, "extract", "catalog", "--database-url", "postgresql://secret-user:secret-password@127.0.0.1:1/postgres",
                     "--timeout-seconds", "2", "--output", str(destination / f"{major}-failed-connection"), success=False)
        assert b"secret-password" not in failed.stderr and b"secret-user" not in failed.stderr
        assert payload(existing) == previous
        run(binary, "extract", "catalog", "--output", str(existing), env=limited_env, success=False)
        run(binary, "extract", "import-extensions", "--catalog", str(existing), "--bundle", str(bundle_file),
            "--output", str(existing), success=False)
        assert payload(existing) == previous
        bundle_file.write_bytes(b"invalid tar")
        run(binary, "extract", "import-extensions", "--catalog", str(existing), "--bundle", str(bundle_file), "--output", str(destination / f"{major}-invalid-bundle"), success=False)
        assert payload(existing) == previous
    finally:
        run("docker", "rm", "-f", "-v", identifier)
    before = owned()
    run(binary, "extract", "catalog", "--docker-image", image,
        "--docker-host-address", "192.0.2.1", "--docker-bind-address", bind,
        "--timeout-seconds", "1", "--output", str(destination / f"{major}-timeout"), success=False)
    assert owned() == before, "timeout leaked a task-owned container"
    assert payload(output) == first
    interrupted = subprocess.Popen([binary, "extract", "catalog", "--docker-image", image,
                                    "--docker-host-address", "192.0.2.1", "--docker-bind-address", bind,
                                    "--output", str(destination / f"{major}-interrupted")], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    deadline = time.monotonic() + 30
    while owned() == before and interrupted.poll() is None:
        assert time.monotonic() < deadline, "interrupt fixture did not start"
        time.sleep(0.1)
    interrupted.terminate()
    interrupted.communicate(timeout=180)
    assert interrupted.returncode != 0
    assert owned() == before, "interrupt leaked a task-owned container"
    assert payload(output) == first
    print(f"PostgreSQL {major}: Docker, supplied connection, deterministic export/import, failure preservation and cleanup passed", flush=True)


def validate_export_contract(binary, destination):
    fixture = destination / "export-fixture"
    if fixture.exists():
        shutil.rmtree(fixture)
    extension = fixture / "share" / "extension"
    extension.mkdir(parents=True)
    content = b"SELECT '<&>';\n"
    target = fixture / "packaged-file"
    target.write_bytes(content)
    name = "odd name-" + "x" * 110 + ".sql"
    (extension / name).symlink_to(target)
    (extension / "odd name.control").write_bytes(b"default_version = '1.0'\n")
    pg_config = fixture / "pg_config"
    pg_config.write_text('#!/bin/sh\ncase "$1" in\n--sharedir) printf "%s\\n" "$EXPORT_TEST_SHARE" ;;\n--version) echo "PostgreSQL 17.6" ;;\nesac\n')
    pg_config.chmod(0o755)
    environment = dict(os.environ, PG_CONFIG=str(pg_config), EXPORT_TEST_SHARE=str(extension.parent))
    script = run(binary, "extract", "export-script").stdout
    archive = run("sh", "-s", data=script, env=environment).stdout
    assert archive == run("sh", "-s", data=script, env=environment).stdout
    with tarfile.open(fileobj=io.BytesIO(archive)) as bundle:
        member = bundle.getmember("extension/" + name)
        assert member.isfile(), "packaging symlink must become a regular file"
        assert bundle.extractfile(member).read() == content
    catalog = fixture / "catalog"
    bundle_file = fixture / "extensions.tar"
    bundle_file.write_bytes(archive)
    run(binary, "extract", "import-extensions", "--bundle", str(bundle_file), "--catalog", str(destination / "17"), "--output", str(catalog))
    assert (catalog / "extension" / name).read_bytes() == content
    (extension / "dangling.sql").symlink_to(fixture / "missing")
    run("sh", "-s", data=script, env=environment, success=False)
    print("Extension export: deterministic PAX, long names, packaging symlink and dangling-link rejection passed", flush=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--binary", required=True)
    parser.add_argument("--output", required=True)
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--bind", default="127.0.0.1")
    args = parser.parse_args()
    destination = Path(args.output).resolve()
    destination.mkdir(parents=True, exist_ok=True)
    args.binary = str(Path(args.binary).resolve())
    # Run the packaged CLI outside the checkout: all runtime resources must be embedded.
    os.chdir(destination)
    validate_interactive_init(args.binary, destination, "connector",
                              "[package.metadata.database]\nconnector = 'tokio-postgres'\n")
    validate_interactive_init(args.binary, destination, "named",
                              "[package.metadata.database.private]\nengine = 'PostgreSQL'\n")
    validate_interactive_init(args.binary, destination, "malformed", "not valid TOML [")
    validate_interactive_init(args.binary, destination, "ambient", "not valid TOML [", True)
    before = owned()
    for major, image in IMAGES.items():
        validate(str(Path(args.binary).resolve()), major, image, destination, args.host, args.bind)
    init_home = destination / "initialized-docker"
    run(args.binary, "init", "--yes", "--docker", "--sql-fun-home", str(init_home),
        "--engines", "postgres", "--engine-versions", ",".join(IMAGES),
        "--docker-host-address", args.host, "--docker-bind-address", args.bind)
    for major in IMAGES:
        assert payload(init_home / "postgres" / major) == payload(destination / major)
    print("Initialization: Docker multi-version installation, server detection, reruns and mismatch diagnostics passed", flush=True)
    validate_export_contract(str(Path(args.binary).resolve()), destination)
    assert owned() == before


if __name__ == "__main__":
    main()
