#!/usr/bin/env bash
# Shared local/CI import lint; scan all eligible sources even with --changed-only.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if ! command -v ast-grep >/dev/null; then
  echo 'ast-grep 0.51.1 required; see CONTRIBUTING.md.' >&2
  exit 1
fi
if [[ $(ast-grep --version) != 'ast-grep 0.51.1' ]]; then
  echo 'ast-grep 0.51.1 required; see CONTRIBUTING.md.' >&2
  exit 1
fi
# Git does not recurse into submodules. Include new maintained files, but never
# ignored build outputs, generated SQL syntax or vendored parser implementations.
mapfile -d '' sources < <(git ls-files -z --cached --others --exclude-standard -- \
  '*.rs' \
  ':!:sql-fun-sqlast/src/syn/generated.rs' \
  ':!:sql-fun-sqlast/src/sqlite_parser/upstream/**' \
  ':!:**/target/**')
# A tracked file may have been deleted in the current change.
existing_sources=()
for source in "${sources[@]}"; do
  [[ -f "$source" ]] || continue
  existing_sources+=("$source")
done
ast-grep test --config sgconfig.yml
if (( ${#existing_sources[@]} )); then
  echo "== Rust import paths (${#existing_sources[@]} source files)"
  ast-grep scan --config sgconfig.yml "${existing_sources[@]}"
fi
