#!/usr/bin/env bash
set -euo pipefail

if [[ $# != 4 || ! "$1" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ || ! "$2" =~ ^[1-9][0-9]*$ ]]; then
  echo 'usage: prepare-pages-prototype OWNER/REPOSITORY RUN_ID TEST_TAG OUTPUT_DIRECTORY' >&2
  exit 1
fi
repository="$1"
run_id="$2"
tag="$3"
output="$4"
scripts="$(cd "$(dirname "$0")" && pwd)"
identity="$("$scripts/../bin/parse-release-version" "$tag")"
[[ "$identity" == *$'\tstable' ]] || { echo 'Pages prototype requires a stable-form test tag (vX.Y.Z)' >&2; exit 1; }

run="$(gh api "repos/$repository/actions/runs/$run_id")"
jq -e --arg repository "$repository" '
  .repository.full_name == $repository and .path == ".github/workflows/build-test.yml"
' <<<"$run" > /dev/null || {
  echo "Expected a build-test.yml run in $repository, got run $run_id" >&2
  exit 1
}
jobs="$(gh api --paginate --slurp "repos/$repository/actions/runs/$run_id/jobs?per_page=100")"
jq -e 'any(.[].jobs[]; .name == "doc" and .conclusion == "success")' <<<"$jobs" > /dev/null || {
  echo "Manual producer job doc has not succeeded ($repository, run $run_id)" >&2
  exit 1
}

temporary="$(mktemp -d)"
trap 'rm -rf "$temporary"' EXIT
"$scripts/adopt-release-ci-inputs" "$repository" "$run_id" "$temporary" sql-fun-user-manual
manual="$temporary/sql-fun-user-manual"
[[ -f "$manual/index.html" ]] || { echo "Manual from run $run_id has no root index.html" >&2; exit 1; }
archive="sql-fun_${tag}_user-manual.tar.gz"
mkdir -p "$output"
tar -czf "$output/$archive" -C "$manual" .
printf 'archive=%s\nsource_sha=%s\n' "$archive" "$(jq -r .head_sha <<<"$run")"
