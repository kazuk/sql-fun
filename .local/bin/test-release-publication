#!/usr/bin/env bash
set -euo pipefail
repo_root="$(git rev-parse --show-toplevel)"
scripts="$repo_root/.local/bin"
fixture="$(mktemp -d)"
trap 'rm -rf "$fixture"' EXIT
mkdir -p "$fixture/bin"
export RELEASE_TEST_ROOT="$fixture"
export RELEASE_TEST_SCRIPTS="$scripts"
export GITHUB_REPOSITORY=fixture/repository

expect_failure() {
  if "$@" > "$fixture/stdout" 2> "$fixture/stderr"; then
    echo "unexpected success: $*" >&2
    exit 1
  fi
}
for tag in v0.2.0 v12.30.400; do
  [[ "$("$scripts/parse-release-version" "$tag")" == *$'\tstable' ]]
done
for tag in v0.2.0-snapshot v0.2.0-snapshot1; do
  [[ "$("$scripts/parse-release-version" "$tag")" == *$'\tsnapshot' ]]
done
for tag in '' main release/v1.2.3 1.2.3 v01.2.3 v1.2 v1.2.3-rc1 'v1.2.3;echo' v1.2.3+build; do
  expect_failure "$scripts/parse-release-version" "$tag"
done

# An annotated immutable tag remains the source after the branch advances.
mkdir "$fixture/source"
git -C "$fixture/source" init -q
git -C "$fixture/source" -c user.name=Fixture -c user.email=fixture@example.invalid commit -q --allow-empty -m 'fixture: materialized release'
revision="$(git -C "$fixture/source" rev-parse HEAD)"
git -C "$fixture/source" -c user.name=Fixture -c user.email=fixture@example.invalid tag -a v0.2.0 -m 'product release'
git -C "$fixture/source" -c user.name=Fixture -c user.email=fixture@example.invalid commit -q --allow-empty -m 'fixture: advance branch'
(cd "$fixture/source"; expect_failure "$scripts/resolve-release-source" v0.2.0)
git -C "$fixture/source" checkout -q --detach v0.2.0
[[ "$(cd "$fixture/source"; "$scripts/resolve-release-source" v0.2.0)" == "$revision" ]]
(cd "$fixture/source"; expect_failure "$scripts/resolve-release-source" v9.9.9)

cat > "$fixture/metadata.json" <<'JSON'
{"workspace_members":["consumer","dependency","private"],"packages":[
{"id":"consumer","name":"consumer","version":"4.5.6","manifest_path":"/consumer/Cargo.toml","source":null,"publish":null,"dependencies":[{"path":"/dependency","name":"dependency"}]},
{"id":"dependency","name":"dependency","version":"1.2.3-snapshot1","manifest_path":"/dependency/Cargo.toml","source":null,"publish":null,"dependencies":[]},
{"id":"private","name":"private","version":"0.0.0","manifest_path":"/private/Cargo.toml","source":null,"publish":[],"dependencies":[]},
{"id":"outside","name":"outside","version":"9.0.0","manifest_path":"/outside/Cargo.toml","source":null,"publish":null,"dependencies":[]}]}
JSON
cat > "$fixture/bin/cargo" <<'MOCK'
#!/usr/bin/env bash
set -euo pipefail
case "$1" in
  metadata)
    [[ "${FAIL_METADATA:-}" != true ]] || exit 1
    cat "$RELEASE_TEST_ROOT/metadata.json"
    ;;
  package)
    [[ "$#" == 10 && "$2" == --package && "$4" == --allow-dirty && "$5" == --no-verify && "$6" == --quiet ]]
    [[ "$7" == --config && "$8" == 'patch.crates-io."consumer".path="/consumer"' ]]
    [[ "$9" == --config && "${10}" == 'patch.crates-io."dependency".path="/dependency"' ]]
    printf '%s\n' "$3" >> "$RELEASE_TEST_ROOT/packaged"
    [[ "${FAIL_PACKAGE:-}" != "$3" ]]
    ;;
  publish)
    [[ "$2" == --package ]]
    package="$3"
    printf '%s\t%s\n' "$package" "$CARGO_REGISTRY_TOKEN" >> "$RELEASE_TEST_ROOT/published"
    if [[ "${FAIL_PACKAGE:-}" == "$package" ]]; then exit 1; fi
    touch "$RELEASE_TEST_ROOT/existing-$package"
    ;;
  *) exit 1 ;;
esac
MOCK
cat > "$fixture/bin/curl" <<'MOCK'
#!/usr/bin/env bash
set -euo pipefail
url="${!#}"
package="${url#https://crates.io/api/v1/crates/}"
package="${package%%/*}"
if [[ "${LOOKUP_ERROR:-}" == true ]]; then echo 503
elif [[ "$url" == */crates/*/* ]]; then
  if [[ -f "$RELEASE_TEST_ROOT/existing-$package" ]]; then echo 200; else echo 404; fi
elif [[ "${NEW_CRATE:-}" == "$package" ]]; then echo 404
else echo 200
fi
MOCK
cat > "$fixture/bin/gh" <<'MOCK'
#!/usr/bin/env bash
set -euo pipefail
if [[ "$1" == api ]]; then
  [[ "${RELEASE_LOOKUP_ERROR:-}" != true ]] || exit 1
  printf '%s\n' v0.1.0 v0.2.0 v0.10.0 v1.0.0-snapshot1 invalid
else
  [[ "$1 $2" == 'release download' ]]
  [[ "${MISSING_MANUAL:-}" != true ]] || exit 1
  while (( $# )); do
    case "$1" in
      --dir) destination="$2"; shift ;;
      --pattern) pattern="$2"; shift ;;
    esac
    shift
  done
  cp "$RELEASE_TEST_ROOT/manual.tar.gz" "$destination/$pattern"
fi
MOCK
chmod +x "$fixture/bin/"*
export PATH="$fixture/bin:$PATH"
"$scripts/release-crate-manifest" > "$fixture/crates.tsv"
printf 'consumer\t4.5.6\ndependency\t1.2.3-snapshot1\n' > "$fixture/expected.tsv"
cmp "$fixture/expected.tsv" "$fixture/crates.tsv"
"$scripts/release-crate-manifest" --with-paths > "$fixture/crates-with-paths.tsv"
printf 'consumer\t4.5.6\t/consumer/Cargo.toml\ndependency\t1.2.3-snapshot1\t/dependency/Cargo.toml\n' > "$fixture/expected.tsv"
cmp "$fixture/expected.tsv" "$fixture/crates-with-paths.tsv"
"$scripts/check-test-flow" --list-steps | grep -qx package-metadata
"$scripts/check-test-flow" --list-steps | grep -qx semver
# SemVer dispatch is optional and the default step list must not contain it.
"$scripts/check-test-flow" --help > "$fixture/flow-help"
awk '/Default steps:/,/Optional steps/' "$fixture/flow-help" > "$fixture/default-steps"
! grep -qx '  semver' "$fixture/default-steps"
# Exercise dispatch without repeating expensive analyzer/tool builds.
mkdir -p "$fixture/flow/.local/bin" "$fixture/flow/.local/sbin" "$fixture/flow/sql-fun-server-api/src/payloads" "$fixture/flow/sql-fun-client/src/payloads"
cp "$scripts/check-test-flow" "$fixture/flow/.local/bin/"
cp "$repo_root/.local/sbin/workspace-nextest" "$fixture/flow/.local/sbin/"
touch "$fixture/flow/sql-fun-server-api/src/payloads.rs" "$fixture/flow/sql-fun-client/src/payloads.rs"
git -C "$fixture/flow" init -q
cat > "$fixture/flow/.local/sbin/prepare-package-api-tests" <<'MOCK'
#!/usr/bin/env bash
printf '%s\n' '{"toolchain":"stable"}'
MOCK
cat > "$fixture/flow/.local/bin/check-semver" <<'MOCK'
#!/usr/bin/env bash
set -euo pipefail
[[ "$*" == "--repository $RELEASE_TEST_ROOT/flow --working-tree --toolchain stable --target "* ]]
touch "$RELEASE_TEST_ROOT/semver-dispatched"
MOCK
chmod +x "$fixture/flow/.local/"{bin/check-semver,sbin/prepare-package-api-tests}
(cd "$fixture/flow"; .local/bin/check-test-flow --step=semver)
[[ -f "$fixture/semver-dispatched" ]]
CI=true "$scripts/check-test-flow" --step=package-metadata
printf 'consumer\ndependency\n' > "$fixture/expected-packaged"
cmp "$fixture/expected-packaged" "$fixture/packaged"
rm "$fixture/packaged"
export FAIL_PACKAGE=consumer
expect_failure env CI=true "$scripts/check-test-flow" --step=package-metadata
[[ "$(cat "$fixture/packaged")" == consumer ]]
unset FAIL_PACKAGE
rm "$fixture/packaged"
export FAIL_METADATA=true
expect_failure env CI=true "$scripts/check-test-flow" --step=package-metadata
[[ ! -e "$fixture/packaged" ]]
unset FAIL_METADATA
export CARGO_REGISTRY_TOKEN=oidc
export CRATES_IO_BOOTSTRAP_TOKEN=bootstrap
export FAIL_PACKAGE=consumer
expect_failure "$scripts/publish-crates" --manifest="$fixture/crates.tsv"
printf 'dependency\toidc\nconsumer\toidc\n' > "$fixture/expected.tsv"
cmp "$fixture/expected.tsv" "$fixture/published"
unset FAIL_PACKAGE
"$scripts/publish-crates" --manifest="$fixture/crates.tsv"
[[ "$(wc -l < "$fixture/published")" == 3 ]]
"$scripts/publish-crates" --manifest="$fixture/crates.tsv"
[[ "$(wc -l < "$fixture/published")" == 3 ]]
rm "$fixture/existing-dependency"
export NEW_CRATE=dependency
"$scripts/publish-crates" --manifest="$fixture/crates.tsv"
[[ "$(tail -n 1 "$fixture/published")" == $'dependency\tbootstrap' ]]
rm "$fixture/existing-dependency"
unset CRATES_IO_BOOTSTRAP_TOKEN
expect_failure "$scripts/publish-crates" --manifest="$fixture/crates.tsv"
export LOOKUP_ERROR=true
expect_failure "$scripts/publish-crates" --manifest="$fixture/crates.tsv"
unset LOOKUP_ERROR
# Dependency cycles must fail without attempting additional publication.
cp "$fixture/metadata.json" "$fixture/original-metadata.json"
jq '(.packages[] | select(.name == "dependency") | .dependencies) = [{"path":"/consumer","name":"consumer"}]' \
  "$fixture/original-metadata.json" > "$fixture/metadata.json"
expect_failure "$scripts/publish-crates" --manifest="$fixture/crates.tsv"
[[ "$(wc -l < "$fixture/published")" == 4 ]]
cp "$fixture/original-metadata.json" "$fixture/metadata.json"
sed 's/consumer\t4.5.6/consumer\t8.0.0/' "$fixture/crates.tsv" > "$fixture/wrong.tsv"
expect_failure "$scripts/publish-crates" --manifest="$fixture/wrong.tsv"

mkdir "$fixture/html"
printf '<html>unchanged release output</html>\n' > "$fixture/html/index.html"
tar -czf "$fixture/manual.tar.gz" -C "$fixture/html" .
"$scripts/prepare-release-manual" v0.10.0 "$fixture/extracted"
cmp "$fixture/html/index.html" "$fixture/extracted/index.html"
expect_failure "$scripts/prepare-release-manual" v0.10.0-snapshot1 "$fixture/snapshot"
export MISSING_MANUAL=true
expect_failure "$scripts/prepare-release-manual" v0.10.0 "$fixture/missing"
unset MISSING_MANUAL
[[ "$("$scripts/release-pages-current" v0.10.0)" == true ]]
[[ "$("$scripts/release-pages-current" v0.2.0)" == false ]]
[[ "$("$scripts/release-pages-current" v1.0.0-snapshot1)" == false ]]
export RELEASE_LOOKUP_ERROR=true
expect_failure "$scripts/release-pages-current" v0.10.0
unset RELEASE_LOOKUP_ERROR

# A successful download containing no built site must still fail consumption.
rm "$fixture/html/index.html"
tar -czf "$fixture/manual.tar.gz" -C "$fixture/html" .
expect_failure "$scripts/prepare-release-manual" v0.10.0 "$fixture/empty"
echo 'Release publication contracts passed'
